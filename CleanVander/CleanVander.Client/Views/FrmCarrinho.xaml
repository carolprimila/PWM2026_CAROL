<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="CleanVander.Client.Views.FrmCarrinho" Title="Meu carrinho" BackgroundColor="#F4F7F4"><Grid RowDefinitions="Auto,*,Auto" Padding="18" RowSpacing="12"><VerticalStackLayout><Label Text="CLEANVANDER · PEDIDO" FontSize="11" CharacterSpacing="2" TextColor="#527464"/><Label Text="Revise seu carrinho" FontSize="26" FontAttributes="Bold" TextColor="#15352A"/></VerticalStackLayout><CollectionView x:Name="ListaCarrinho" Grid.Row="1" SelectionMode="None"><CollectionView.EmptyView><VerticalStackLayout Padding="22"><Label Text="Seu carrinho está vazio." FontSize="18" TextColor="#52635A"/><Button Text="Voltar aos produtos" Clicked="Voltar"/></VerticalStackLayout></CollectionView.EmptyView><CollectionView.ItemTemplate><DataTemplate><Border Stroke="#E1E9E3" BackgroundColor="White" StrokeShape="RoundRectangle 14" Padding="12" Margin="0,4"><Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto"><Label Text="{Binding Descricao}" FontSize="16" FontAttributes="Bold" TextColor="#193B2D"/><HorizontalStackLayout Grid.Row="1" Spacing="4"><Label Text="{Binding TamanhoVolume}" FontSize="12" TextColor="#718078"/><Label Text="·" FontSize="12" TextColor="#718078"/><Label Text="{Binding Preco, StringFormat='R$ {0:F2}'}" FontSize="12" TextColor="#718078"/><Label Text="cada" FontSize="12" TextColor="#718078"/></HorizontalStackLayout><HorizontalStackLayout Grid.Row="2" Spacing="10" Margin="0,8,0,0"><Button Text="−" Clicked="Diminuir" CommandParameter="{Binding .}" WidthRequest="38" HeightRequest="36" Padding="0"/><Label Text="{Binding Quantidade}" VerticalTextAlignment="Center"/><Button Text="+" Clicked="Aumentar" CommandParameter="{Binding .}" WidthRequest="38" HeightRequest="36" Padding="0"/><Label Text="{Binding Subtotal, StringFormat='R$ {0:F2}'}" VerticalTextAlignment="Center" FontAttributes="Bold" TextColor="#1B6047"/></HorizontalStackLayout><Button Grid.Column="1" Grid.RowSpan="3" Text="Remover" Clicked="Remover" CommandParameter="{Binding .}" BackgroundColor="#FCE8E5" TextColor="#A83E32" VerticalOptions="Center"/></Grid></Border></DataTemplate></CollectionView.ItemTemplate></CollectionView><VerticalStackLayout Grid.Row="2" Spacing="8"><Grid ColumnDefinitions="*,Auto"><Label Text="Total do pedido" FontSize="17" FontAttributes="Bold"/><Label x:Name="Total" Grid.Column="1" FontSize="20" FontAttributes="Bold" TextColor="#1B6047"/></Grid><Label Text="Pagamento: à vista na entrega" FontSize="13" TextColor="#65746B"/><Button Text="Enviar pedido à empresa" Clicked="EnviarPedido" BackgroundColor="#1B6047" TextColor="White" CornerRadius="14"/></VerticalStackLayout></Grid></ContentPage>


