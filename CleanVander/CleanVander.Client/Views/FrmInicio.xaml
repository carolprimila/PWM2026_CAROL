<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="CleanVander.Client.Views.FrmInicio" Title="Produtos" BackgroundColor="#F4F7F4"><Grid RowDefinitions="Auto,Auto,*" Padding="18" RowSpacing="12"><Grid ColumnDefinitions="*,Auto"><VerticalStackLayout><Label Text="CLEANVANDER" FontSize="12" CharacterSpacing="2" TextColor="#527464"/><Label Text="Produtos de limpeza" FontSize="26" FontAttributes="Bold" TextColor="#15352A"/></VerticalStackLayout><Button Grid.Column="1" Text="🛒 Carrinho" Clicked="AbrirCarrinho" BackgroundColor="#1B6047" TextColor="White" CornerRadius="14"/></Grid><Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8"><SearchBar x:Name="Busca" Placeholder="Buscar produto ou categoria" TextChanged="BuscarProdutos" BackgroundColor="White"/><Button Grid.Column="1" Text="Pedidos" Clicked="AbrirPedidos" BackgroundColor="#DDEAE2" TextColor="#15352A" CornerRadius="12"/></Grid><CollectionView x:Name="ListaProdutos" Grid.Row="2" SelectionMode="None"><CollectionView.EmptyView><Label Text="Nenhum produto encontrado. Verifique se a API está iniciada." Margin="12" TextColor="#728178"/></CollectionView.EmptyView><CollectionView.ItemTemplate><DataTemplate><Border Stroke="#E1E9E3" StrokeThickness="1" BackgroundColor="White" StrokeShape="RoundRectangle 16" Padding="14" Margin="0,4"><Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto"><Label Text="{Binding Categoria}" FontSize="11" TextColor="#56806C" CharacterSpacing="1"/><Label Grid.Row="1" Text="{Binding Descricao}" FontSize="18" FontAttributes="Bold" TextColor="#193B2D"/><Label Grid.Row="2" Text="{Binding Info}" FontSize="12" TextColor="#718078"/><Label Grid.Row="3" Text="{Binding Preco, StringFormat='R$ {0:F2}'}" FontSize="18" FontAttributes="Bold" TextColor="#1B6047" Margin="0,8,0,0"/><Button Grid.Column="1" Grid.RowSpan="4" Text="Adicionar +" Clicked="AdicionarProduto" CommandParameter="{Binding .}" VerticalOptions="Center" BackgroundColor="#E4F0E7" TextColor="#1B6047" CornerRadius="12"/></Grid></Border></DataTemplate></CollectionView.ItemTemplate></CollectionView></Grid></ContentPage>


