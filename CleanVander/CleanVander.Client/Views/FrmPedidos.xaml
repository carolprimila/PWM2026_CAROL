<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="CleanVander.Client.Views.FrmPedidos" Title="Meus pedidos" BackgroundColor="#F4F7F4"><CollectionView x:Name="ListaPedidos" Margin="18" SelectionMode="None"><CollectionView.Header><VerticalStackLayout Spacing="5" Margin="0,0,0,14"><Label Text="CLEANVANDER · HISTÓRICO" FontSize="11" CharacterSpacing="2" TextColor="#527464"/><Label Text="Meus pedidos" FontSize="26" FontAttributes="Bold" TextColor="#15352A"/></VerticalStackLayout></CollectionView.Header><CollectionView.EmptyView><Label Text="Nenhum pedido encontrado." Margin="12" TextColor="#728178"/></CollectionView.EmptyView><CollectionView.ItemTemplate><DataTemplate><Border Stroke="#E1E9E3" BackgroundColor="White" StrokeShape="RoundRectangle 16" Padding="14" Margin="0,4"><VerticalStackLayout Spacing="6"><Grid ColumnDefinitions="*,Auto"><Label Text="{Binding Numero}" FontAttributes="Bold" FontSize="16" TextColor="#193B2D"/><Label Grid.Column="1" Text="{Binding Status}" TextColor="#1B6047" FontAttributes="Bold"/></Grid><HorizontalStackLayout><Label Text="{Binding CriadoEm, StringFormat='{0:dd/MM/yyyy HH:mm}'}" TextColor="#627168"/><Label Text="{Binding Total, StringFormat='R$ {0:F2}'}" TextColor="#627168"/></HorizontalStackLayout><Label Text="{Binding FormaPagamento}" FontSize="12" TextColor="#627168"/><Label Text="{Binding ResumoItens}" FontSize="13" TextColor="#45564C"/><Button Text="Repetir pedido e revisar itens" Clicked="RepetirPedido" CommandParameter="{Binding .}" BackgroundColor="#E4F0E7" TextColor="#1B6047" CornerRadius="12" HorizontalOptions="Start"/></VerticalStackLayout></Border></DataTemplate></CollectionView.ItemTemplate></CollectionView></ContentPage>

