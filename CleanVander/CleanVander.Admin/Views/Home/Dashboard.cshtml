@model CleanVander.Admin.Models.DashboardViewModel
@{ ViewData["Title"]="Painel administrativo"; }
<header class="dashboard-top"><div class="brand"><span class="brand-mark small">CV</span><div><strong>CleanVander</strong><small>Painel da empresa</small></div></div><form asp-action="Logout" method="post"><button class="subtle" type="submit">Sair <span>↗</span></button></form></header>
@if (ViewData["Erro"] is string erro) { <div class="alert error">@erro</div> }
@if (TempData["Erro"] is string e) { <div class="alert error">@e</div> }
@if (TempData["Sucesso"] is string s) { <div class="alert success">@s</div> }
<main class="container dashboard">
  <section class="welcome"><div><p class="eyebrow">CENTRAL DE OPERAÇÕES</p><h1>Bom dia, equipe.</h1><p>Acompanhe a operação e mantenha o catálogo atualizado.</p></div><div class="welcome-icon">✦</div></section>
  <div class="stats"><article><span>Pedidos</span><strong>@Model.Pedidos.Count</strong><small>na base oficial</small></article><article><span>Clientes</span><strong>@Model.Clientes.Count</strong><small>cadastros ativos</small></article><article><span>Produtos</span><strong>@Model.Produtos.Count</strong><small>no catálogo</small></article><article><span>Em andamento</span><strong>@Model.Pedidos.Count(p => p.Status is not "Entregue" and not "Cancelado")</strong><small>pedidos abertos</small></article></div>
  <section class="panel"><div class="section-heading"><div><p class="eyebrow">CATÁLOGO</p><h2>Produtos</h2></div></div>
    <details class="form-details"><summary>+ Cadastrar produto</summary><form asp-action="SalvarProduto" method="post" class="product-form"><input name="Codigo" placeholder="Código (ex.: DET-001)" required /><input name="Descricao" placeholder="Descrição" required /><input name="Categoria" placeholder="Categoria" required /><input name="UnidadeMedida" placeholder="Unidade (UN)" value="UN" required /><input name="TamanhoVolume" placeholder="Tamanho / volume" required /><input name="Preco" type="number" step="0.01" min="0" placeholder="Preço (R$)" required /><label class="check"><input name="Ativo" type="checkbox" value="true" checked /> Ativo</label><button class="primary" type="submit">Salvar produto</button></form></details>
    <div class="table-wrap"><table><thead><tr><th>Código</th><th>Produto</th><th>Categoria</th><th>Apresentação</th><th>Preço</th><th>Disponível</th><th>Editar</th></tr></thead><tbody>
    @foreach (var p in Model.Produtos) { <tr><td><span class="code">@p.Codigo</span></td><td><strong>@p.Descricao</strong></td><td>@p.Categoria</td><td>@p.TamanhoVolume · @p.UnidadeMedida</td><td>@p.Preco.ToString("C2", new System.Globalization.CultureInfo("pt-BR"))</td><td><span class="pill @(p.Ativo ? "ok" : "off")">@(p.Ativo ? "Ativo" : "Pausado")</span></td><td><details class="inline-edit"><summary>Editar</summary><form asp-action="SalvarProduto" method="post" class="edit-form"><input type="hidden" name="Id" value="@p.Id"/><input name="Codigo" value="@p.Codigo" required/><input name="Descricao" value="@p.Descricao" required/><input name="Categoria" value="@p.Categoria" required/><input name="UnidadeMedida" value="@p.UnidadeMedida" required/><input name="TamanhoVolume" value="@p.TamanhoVolume" required/><input name="Preco" type="number" step="0.01" min="0" value="@p.Preco" required/><label><input name="Ativo" type="checkbox" value="true" checked="@p.Ativo"/> Ativo</label><button class="primary" type="submit">Atualizar</button></form></details></td></tr> }
    @if (Model.Produtos.Count == 0) { <tr><td colspan="7" class="empty">Nenhum produto cadastrado.</td></tr> }
    </tbody></table></div>
  </section>
  <section class="panel"><div class="section-heading"><div><p class="eyebrow">OPERAÇÃO</p><h2>Pedidos recentes</h2></div></div><div class="table-wrap"><table><thead><tr><th>Pedido</th><th>Cliente</th><th>Data</th><th>Itens</th><th>Total</th><th>Status</th><th>Atualizar</th></tr></thead><tbody>
  @foreach (var p in Model.Pedidos) { <tr><td><span class="code">@p.Numero</span></td><td><strong>@(p.Cliente?.Nome ?? "—")</strong><small class="block">@(p.Cliente?.Documento ?? "")</small></td><td>@p.CriadoEm.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td><td>@p.Itens.Sum(i => i.Quantidade) produto(s)</td><td>@p.Total.ToString("C2", new System.Globalization.CultureInfo("pt-BR"))</td><td><span class="pill">@p.Status.Replace("EmSeparacao", "Em separação").Replace("EnviadoParaEntrega", "Enviado para entrega")</span></td><td><form asp-action="AtualizarStatus" method="post" class="status-form"><input type="hidden" name="PedidoId" value="@p.Id"/><select name="Status"><option value="Recebido" selected="@(p.Status == "Recebido")">Recebido</option><option value="EmSeparacao" selected="@(p.Status == "EmSeparacao")">Em separação</option><option value="EnviadoParaEntrega" selected="@(p.Status == "EnviadoParaEntrega")">Enviado para entrega</option><option value="Entregue" selected="@(p.Status == "Entregue")">Entregue</option><option value="Cancelado" selected="@(p.Status == "Cancelado")">Cancelado</option></select><button class="icon-button" title="Atualizar status" type="submit">✓</button></form></td></tr><tr class="order-detail"><td colspan="7">@string.Join(" · ", p.Itens.Select(i => $"{i.Quantidade}x {i.DescricaoProduto}")) <span>· pagamento à vista na entrega</span></td></tr> }
  @if (Model.Pedidos.Count == 0) { <tr><td colspan="7" class="empty">Ainda não há pedidos.</td></tr> }
  </tbody></table></div></section>
  <section class="panel"><div class="section-heading"><div><p class="eyebrow">CADASTROS</p><h2>Clientes</h2></div></div><div class="table-wrap"><table><thead><tr><th>Tipo</th><th>Nome / empresa</th><th>Documento</th><th>Contato</th><th>Endereço</th></tr></thead><tbody>@foreach(var c in Model.Clientes){<tr><td>@(c.TipoPessoa == "Juridica" ? "Pessoa jurídica" : "Pessoa física")</td><td><strong>@c.Nome</strong></td><td>@c.Documento</td><td>@c.Telefone<small class="block">@c.Email</small></td><td>@c.Endereco</td></tr>} @if(Model.Clientes.Count == 0){<tr><td colspan="5" class="empty">Ainda não há cadastros de clientes.</td></tr>}</tbody></table></div></section>
  <footer class="footnote">CleanVander · Pagamento à vista na entrega · Controle de estoque desativado nesta versão.</footer>
</main>
