<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="VanderBakery.Mobile.MainPage" BackgroundColor="#FFF8FA" Shell.NavBarIsVisible="False">
 <Grid><Grid x:Name="AppPanel" RowDefinitions="Auto,*" IsVisible="False">
  <Grid Grid.Row="0" BackgroundColor="#FFFFFF" Padding="18,13" ColumnDefinitions="Auto,*,Auto"><Border BackgroundColor="#E77B9E" StrokeThickness="0" StrokeShape="RoundRectangle 13" WidthRequest="42" HeightRequest="42"><Label Text="♡" TextColor="White" FontSize="23" HorizontalTextAlignment="Center" VerticalTextAlignment="Center"/></Border><VerticalStackLayout Grid.Column="1" Margin="11,0" VerticalOptions="Center" Spacing="0"><Label Text="VanderBakery" FontSize="18" FontAttributes="Bold" TextColor="#503742"/><Label Text="SEDE · FOZ DO IGUAÇU" FontSize="9" CharacterSpacing="1" TextColor="#C16988"/></VerticalStackLayout><Button Grid.Column="2" Text="Sair" Clicked="LogoutClicked" BackgroundColor="#FFF0F5" TextColor="#C16988" CornerRadius="12" Padding="12,0"/></Grid>
  <ScrollView Grid.Row="1"><VerticalStackLayout Padding="17,19,17,32" Spacing="16">
   <Border BackgroundColor="#FCE8EE" StrokeThickness="0" StrokeShape="RoundRectangle 20" Padding="20"><VerticalStackLayout Spacing="4"><Label Text="SUA ROTA, SEU DIA" TextColor="#C16988" FontSize="10" FontAttributes="Bold" CharacterSpacing="1.5"/><Label x:Name="GreetingLabel" Text="Bom dia, Gabriel" TextColor="#503742" FontSize="26" FontAttributes="Bold"/><Label Text="Foz do Iguaçu · Santa Terezinha" TextColor="#967D87" FontSize="12"/></VerticalStackLayout></Border>
   <Border BackgroundColor="White" Stroke="#F2E7EB" StrokeThickness="1" StrokeShape="RoundRectangle 16" Padding="15"><VerticalStackLayout Spacing="10"><Grid ColumnDefinitions="*,Auto"><Label Text="Roteiro de visitas" TextColor="#503742" FontSize="17" FontAttributes="Bold"/><Picker x:Name="DayPicker" Grid.Column="1" Title="Dia" WidthRequest="145" SelectedIndexChanged="DayChanged"/></Grid><VerticalStackLayout x:Name="RouteList" Spacing="8"/></VerticalStackLayout></Border>
   <Border BackgroundColor="White" Stroke="#F2E7EB" StrokeThickness="1" StrokeShape="RoundRectangle 16" Padding="15"><VerticalStackLayout Spacing="10"><Grid ColumnDefinitions="*,Auto"><VerticalStackLayout><Label Text="Registrar venda" TextColor="#503742" FontSize="17" FontAttributes="Bold"/><Label Text="A API confere o estoque antes de confirmar." TextColor="#A18A93" FontSize="11"/></VerticalStackLayout><Button Grid.Column="1" Text="Concluir venda" Clicked="SellClicked" BackgroundColor="#D87596" TextColor="White" CornerRadius="11" FontAttributes="Bold" Padding="14,0"/></Grid><Picker x:Name="CustomerPicker" Title="Selecione o cliente"/><Picker x:Name="PaymentMethodPicker" Title="Forma de pagamento"/><Picker x:Name="PaymentConditionPicker" Title="Parcelamento" SelectedIndexChanged="PaymentConditionChanged"/><Label x:Name="PaymentTermsLabel" Text="Multa 5% · Juros 2% ao dia · Desconto 1% ao dia" TextColor="#A18A93" FontSize="10"/><VerticalStackLayout x:Name="ProductList" Spacing="8"/></VerticalStackLayout></Border>
   <Border BackgroundColor="White" Stroke="#F2E7EB" StrokeThickness="1" StrokeShape="RoundRectangle 16" Padding="15"><VerticalStackLayout Spacing="10"><Grid ColumnDefinitions="*,Auto"><VerticalStackLayout><Label Text="Clientes" TextColor="#503742" FontSize="17" FontAttributes="Bold"/><Label Text="Histórico de compras e cadastro" TextColor="#A18A93" FontSize="11"/></VerticalStackLayout><Button Grid.Column="1" Text="＋ Novo" Clicked="ToggleCustomerForm" BackgroundColor="#FFF0F5" TextColor="#C16988" CornerRadius="10"/></Grid><VerticalStackLayout x:Name="CustomerForm" IsVisible="False" Spacing="8"><Entry x:Name="NameEntry" Placeholder="Nome completo *"/><Entry x:Name="TradeEntry" Placeholder="Nome fantasia (opcional)"/><Entry x:Name="TaxIdEntry" Placeholder="CPF ou CNPJ *"/><Entry x:Name="EmailEntry" Placeholder="E-mail *" Keyboard="Email"/><Picker x:Name="CityPicker" Title="Cidade" SelectedIndexChanged="CityChanged"/><Picker x:Name="NeighborhoodPicker" Title="Bairro"/><Button Text="Salvar cliente" Clicked="SaveCustomerClicked" BackgroundColor="#D87596" TextColor="White" CornerRadius="10"/></VerticalStackLayout><Picker x:Name="HistoryCustomerPicker" Title="Ver histórico do cliente" SelectedIndexChanged="HistoryCustomerChanged"/><VerticalStackLayout x:Name="HistoryList" Spacing="7"/></VerticalStackLayout></Border>
   <Border BackgroundColor="#FFF0F5" StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="12"><Label x:Name="StatusLabel" Text="Bom dia! Selecione um dia para ver sua rota." TextColor="#A95774" FontSize="12"/></Border>
  </VerticalStackLayout></ScrollView>
 </Grid><ScrollView Grid.RowSpan="2" x:Name="AuthPanel" BackgroundColor="#FFF8FA"><VerticalStackLayout VerticalOptions="Center" Padding="28" Spacing="15"><Label Text="♡  VanderBakery" TextColor="#503742" FontSize="27" FontAttributes="Bold" HorizontalTextAlignment="Center"/><Label Text="SEDE · FOZ DO IGUAÇU" TextColor="#C16988" FontSize="11" CharacterSpacing="1.5" HorizontalTextAlignment="Center"/><Border BackgroundColor="White" Stroke="#F2E7EB" StrokeThickness="1" StrokeShape="RoundRectangle 22" Padding="23"><VerticalStackLayout Spacing="12"><Label x:Name="AuthTitle" Text="Entrar como vendedor" TextColor="#503742" FontSize="22" FontAttributes="Bold"/><Entry x:Name="AuthNameEntry" Placeholder="Nome completo" IsVisible="False" TextColor="#503742" PlaceholderColor="#9D8791" BackgroundColor="White"/><Entry x:Name="AuthEmailEntry" Placeholder="E-mail" Keyboard="Email" Text="vendedor@vanderbakery.com" TextColor="#503742" PlaceholderColor="#9D8791" BackgroundColor="White"/><Grid ColumnDefinitions="*,Auto" ColumnSpacing="6"><Entry x:Name="AuthPasswordEntry" Grid.Column="0" Placeholder="Senha" IsPassword="True" Text="Vander123!" TextColor="#503742" PlaceholderColor="#9D8791" BackgroundColor="White"/><Button x:Name="PasswordToggleButton" Grid.Column="1" Text="Mostrar" Clicked="PasswordToggleClicked" BackgroundColor="#FFF0F5" TextColor="#B95779" CornerRadius="10" Padding="12,0"/></Grid><Label x:Name="AuthMessageLabel" TextColor="#B95779" FontSize="12"/><Button x:Name="AuthSubmitButton" Text="Entrar" Clicked="AuthSubmitClicked" BackgroundColor="#D87596" TextColor="White" CornerRadius="12"/><Button x:Name="AuthToggleButton" Text="Criar cadastro de vendedor" Clicked="AuthToggleClicked" BackgroundColor="Transparent" TextColor="#B95779"/><Label Text="Demonstração: vendedor@vanderbakery.com · Vander123!" TextColor="#A18A93" FontSize="10" HorizontalTextAlignment="Center"/></VerticalStackLayout></Border></VerticalStackLayout></ScrollView></Grid>
</ContentPage>
