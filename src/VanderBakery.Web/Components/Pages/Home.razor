@page "/"
@rendermode InteractiveServer
@using System.Net.Http.Json
@inject IHttpClientFactory ClientFactory
<PageTitle>VanderBakery · Foz do Iguaçu</PageTitle>
<header class="topbar"><div class="brand"><span class="brand-icon">♡</span><div><b>VanderBakery</b><small>SEDE · FOZ DO IGUAÇU</small></div></div><nav><a href="#inicio">Início</a><a href="#clientes">Clientes</a><a href="#estoque">Estoque</a><a href="#vendas">Vendas</a><a href="#rota">Rotas</a></nav><span class="location">⌖ Foz do Iguaçu · PR</span></header>
<main class="dashboard" id="inicio">
 <div class="hero"><div><span class="kicker">@DateTime.Today.ToString("dddd · dd 'DE' MMMM", new System.Globalization.CultureInfo("pt-BR")).ToUpperInvariant()</span><h1>Bom dia, sua operação<br/>está <em>em boas mãos.</em></h1><p>Vendas, clientes e estoque da sede de Foz do Iguaçu.</p></div><div class="hero-art">🥐<span>feito com carinho</span></div></div>
 @if (_message is not null) { <div class="notice">@_message</div> }
 <div class="metrics"><article><small>VENDAS DE HOJE</small><strong>@_report?.Revenue.ToString("C")</strong><span> @_report?.SaleCount vendas registradas</span></article><article><small>LUCRO BRUTO DE HOJE</small><strong class="pink">@_report?.Profit.ToString("C")</strong><span>Receita menos custo dos produtos</span></article><article><small>CLIENTES CADASTRADOS</small><strong>@_customers.Count</strong><span>Foz do Iguaçu e Santa Terezinha</span></article><article><small>ITENS COM ESTOQUE</small><strong>@_products.Count(p=>p.Stock>0)</strong><span>Estoque conferido em toda venda</span></article></div>
 <section class="panel" id="vendas"><div class="section-head"><div><span class="kicker">RESULTADOS REAIS</span><h2>Histórico de vendas e lucro</h2></div><input type="date" @bind="_date" @bind:after="Reload" /></div><div class="report-strip"><div><small>Faturamento do dia</small><b>@_report?.Revenue.ToString("C")</b></div><div><small>Lucro bruto do dia</small><b class="pink">@_report?.Profit.ToString("C")</b></div></div><div class="table-scroll"><table><thead><tr><th>HORÁRIO / CLIENTE</th><th>ITENS VENDIDOS</th><th>VALOR DA VENDA</th><th>LUCRO</th></tr></thead><tbody>@foreach(var sale in _sales){<tr><td><b>@sale.Customer</b><small>@sale.CreatedAt.ToLocalTime().ToString("HH:mm") · @sale.City</small></td><td>@string.Join(" · ",sale.Items.Select(i=>$"{i.Quantity:0.##} {i.ProductName}"))</td><td>@sale.Total.ToString("C")</td><td class="pink">@sale.Profit.ToString("C")<small>@string.Join(" + ",sale.Items.Select(i=>$"{i.ProductName}: {i.Profit:C}"))</small></td></tr>}</tbody></table>@if(_sales.Count==0){<p class="empty">Ainda não há vendas nesta data.</p>}</div></section>
 <div class="columns">
  <section class="panel" id="clientes"><div class="section-head"><div><span class="kicker">RELACIONAMENTO</span><h2>Clientes</h2></div><span class="pill">@_customers.Count clientes</span></div><details class="formbox"><summary>＋ Cadastrar cliente</summary><div class="formgrid"><input placeholder="Nome completo *" @bind="_customer.Name"/><input placeholder="Nome fantasia (opcional)" @bind="_customer.TradeName"/><input placeholder="CPF ou CNPJ *" @bind="_customer.TaxId"/><input placeholder="E-mail *" type="email" @bind="_customer.Email"/><select @bind="_customer.City" @bind:after="CityChanged"><option>Foz do Iguaçu</option><option>Santa Terezinha de Itaipu</option></select><select @bind="_customer.Neighborhood"><option value="">Selecione o bairro *</option>@foreach(var n in _locations.GetValueOrDefault(_customer.City,[])){<option>@n</option>}</select></div><button class="button" @onclick="CreateCustomer">Salvar cliente</button></details><div class="list">@foreach(var c in _customers){<div class="listrow"><span class="avatar">@c.Name[..1].ToUpper()</span><div class="grow"><b>@c.Name</b><small>@c.City · @c.Neighborhood · @c.TaxId</small></div>@if(c.OpenBalance>0){<span class="pill debt">Em aberto @c.OpenBalance.ToString("C")</span>}</div>}</div></section>
  <section class="panel" id="estoque"><div class="section-head"><div><span class="kicker">CONTROLE SEGURO</span><h2>Produtos e estoque</h2></div></div><details class="formbox"><summary>＋ Cadastrar produto</summary><div class="formgrid"><input placeholder="Nome do produto" @bind="_product.Name"/><input placeholder="Grupo" @bind="_product.Group"/><input placeholder="Unidade / embalagem" @bind="_product.Unit"/><input placeholder="Preço de venda" type="number" step=".01" @bind="_product.Price"/><input placeholder="Custo unitário" type="number" step=".01" @bind="_product.Cost"/><input placeholder="Estoque inicial" type="number" step=".01" @bind="_product.Stock"/><input type="date" @bind="_product.ExpiryDate"/></div><button class="button" @onclick="CreateProduct">Salvar produto</button></details><div class="list">@foreach(var p in _products){<div class="listrow"><span class="product-icon">✿</span><div class="grow"><b>@p.Name</b><small>@p.Group · @p.Unit · @p.Price.ToString("C") · vence @(p.ExpiryDate?.ToString("dd/MM/yy")??"sem validade")</small></div><span class="stock @(p.Stock<4?"low":"")">@p.Stock.ToString("0.##") @p.Unit</span><input class="stock-input" type="number" min="0" step=".01" @bind="p.NewStock" title="Novo saldo"/><button class="button small" @onclick="()=>SetStock(p)">Atualizar</button></div>}</div><p class="footnote">Cada venda valida e baixa o estoque automaticamente. Venda sem estoque é bloqueada.</p></section>
 </div>
 <section class="panel" id="rota"><div class="section-head"><div><span class="kicker">VISITAS DO VENDEDOR</span><h2>Roteiro por dia da semana</h2></div><select @bind="_routeDay" @bind:after="LoadRoute"><option>Segunda-feira</option><option>Terça-feira</option><option>Quarta-feira</option><option>Quinta-feira</option><option>Sexta-feira</option><option>Sábado</option><option>Domingo</option></select></div><div class="routegrid">@foreach(var stop in _route){<div class="routecard"><span class="route-number">@stop.Position.ToString("00")</span><div><b>@stop.Name</b><small>@stop.City · @stop.Neighborhood</small></div></div>}@if(_route.Count==0){<p class="empty">Nenhuma visita cadastrada para @_routeDay.</p>}</div><details class="formbox route-form"><summary>＋ Adicionar cliente à rota</summary><div class="formgrid"><select @bind="_routeCustomer"><option value="0">Selecione um cliente</option>@foreach(var c in _customers){<option value="@c.Id">@c.Name</option>}</select><select @bind="_routeDay"><option>Segunda-feira</option><option>Terça-feira</option><option>Quarta-feira</option><option>Quinta-feira</option><option>Sexta-feira</option><option>Sábado</option><option>Domingo</option></select><input type="number" min="1" placeholder="Ordem de visita" @bind="_position"/></div><button class="button" @onclick="SaveRoute">Salvar visita</button></details></section>
 <section class="panel" id="financeiro"><div class="section-head"><div><span class="kicker">CONTAS A RECEBER</span><h2>Parcelas dos clientes</h2></div><span class="pill">Em aberto @_receivables.Where(r=>!r.Paid).Sum(r=>r.Amount).ToString("C")</span></div><div class="table-scroll"><table><thead><tr><th>CLIENTE</th><th>PARCELA / VENCIMENTO</th><th>FORMA</th><th>VALOR</th><th>STATUS</th></tr></thead><tbody>@foreach(var item in _receivables){<tr><td><b>@item.Customer</b></td><td>@item.InstallmentNumber · @item.DueDate.ToString("dd/MM/yyyy")</td><td>@item.PaymentMethod</td><td>@item.Amount.ToString("C")</td><td><button class="button small @(item.Paid?"paid":"")" @onclick="()=>SetPaid(item)">@(item.Paid?"Recebido":"Marcar recebido")</button></td></tr>}</tbody></table>@if(_receivables.Count==0){<p class="empty">Nenhuma parcela cadastrada ainda.</p>}</div><p class="footnote">As condições 10 e 20 calculam vencimentos, multa de 5%, juros de 2% ao dia e desconto de 1% ao dia. A baixa manual atualiza o status da parcela.</p></section>
 <footer>VanderBakery · Distribuidora de produtos de panificação <span>♡ Foz do Iguaçu, Paraná</span></footer>
</main>
@code {
 private HttpClient Api => ClientFactory.CreateClient("BakeryApi");
 private string? _message; private DateOnly _date=DateOnly.FromDateTime(DateTime.Today); private string _routeDay=Weekday(DateTime.Today); private int _routeCustomer; private int _position=1;
 private Report? _report; private List<SaleRow> _sales=[]; private List<CustomerRow> _customers=[]; private List<ProductRow> _products=[]; private List<RouteRow> _route=[]; private List<ReceivableRow> _receivables=[];
 private Dictionary<string,string[]> _locations=[]; private CustomerForm _customer=new(); private ProductForm _product=new();
 protected override async Task OnInitializedAsync(){_locations=await Api.GetFromJsonAsync<Dictionary<string,string[]>>("api/locations")??[]; _customer.City="Foz do Iguaçu"; await Reload();}
 private async Task Reload(){try{var d=_date.ToString("yyyy-MM-dd");_report=await Api.GetFromJsonAsync<Report>($"api/reports/daily?date={d}");_sales=await Api.GetFromJsonAsync<List<SaleRow>>($"api/sales?date={d}")??[];_customers=await Api.GetFromJsonAsync<List<CustomerRow>>("api/customers")??[];_products=await Api.GetFromJsonAsync<List<ProductRow>>("api/products")??[];_receivables=await Api.GetFromJsonAsync<List<ReceivableRow>>("api/receivables")??[];await LoadRoute();}catch{_message="API indisponível. Inicie a VanderBakery.Api para carregar os dados.";}}
 private async Task SetPaid(ReceivableRow item){try{await Api.PutAsJsonAsync($"api/receivables/{item.Id}/paid?paid={!item.Paid}",new{});await Reload();}catch{_message="Não foi possível atualizar a parcela.";}}
 private async Task LoadRoute(){try{_route=await Api.GetFromJsonAsync<List<RouteRow>>($"api/routes?day={Uri.EscapeDataString(_routeDay)}")??[];}catch{}}
 private void CityChanged(){_customer.Neighborhood="";}
 private async Task CreateCustomer(){try{var r=await Api.PostAsJsonAsync("api/customers",_customer);if(!r.IsSuccessStatusCode){_message=(await r.Content.ReadFromJsonAsync<ApiError>())?.Message??"Não foi possível cadastrar.";return;}_message="Cliente cadastrado com sucesso!";_customer=new(){City="Foz do Iguaçu"};await Reload();}catch{_message="Não foi possível conectar à API.";}}
 private async Task CreateProduct(){try{var r=await Api.PostAsJsonAsync("api/products",_product);if(!r.IsSuccessStatusCode){_message="Confira os dados do produto.";return;}_message="Produto e estoque cadastrados.";_product=new();await Reload();}catch{_message="Não foi possível conectar à API.";}}
 private async Task SetStock(ProductRow product){try{var r=await Api.PutAsJsonAsync($"api/products/{product.Id}/stock?quantity={product.NewStock.ToString(System.Globalization.CultureInfo.InvariantCulture)}",new{});_message=r.IsSuccessStatusCode?$"Estoque atualizado para {product.Name}.":"Não foi possível atualizar o estoque.";await Reload();}catch{_message="Não foi possível conectar à API.";}}
 private async Task SaveRoute(){try{var r=await Api.PostAsJsonAsync($"api/customers/{_routeCustomer}/route",new{day=_routeDay,position=_position});_message=r.IsSuccessStatusCode?"Visita adicionada à rota.":"Selecione um cliente e uma ordem válida.";await LoadRoute();}catch{_message="Não foi possível conectar à API.";}}
 private static string Weekday(DateTime d){var ci=new System.Globalization.CultureInfo("pt-BR");var s=ci.DateTimeFormat.GetDayName(d.DayOfWeek);return char.ToUpper(s[0])+s[1..];}
 private sealed class CustomerForm{public string Name{get;set;}="";public string? TradeName{get;set;}public string TaxId{get;set;}="";public string Email{get;set;}="";public string City{get;set;}="Foz do Iguaçu";public string Neighborhood{get;set;}="";}
 private sealed class ProductForm{public string Name{get;set;}="";public string Group{get;set;}="";public string Unit{get;set;}="un";public decimal Price{get;set;}public decimal Cost{get;set;}public decimal Stock{get;set;}public DateOnly? ExpiryDate{get;set;}}
 private sealed record ApiError(string? Message);private sealed record Report(decimal Revenue,decimal Profit,int SaleCount);private sealed record CustomerRow(int Id,string Name,string? TradeName,string TaxId,string Email,string City,string Neighborhood,bool Active,decimal OpenBalance);private sealed class ProductRow{public int Id{get;set;}public string Name{get;set;}="";public string Group{get;set;}="";public string Unit{get;set;}="";public decimal Price{get;set;}public decimal Cost{get;set;}public decimal Stock{get;set;}public DateOnly? ExpiryDate{get;set;}public decimal NewStock{get;set;}}private sealed record SaleRow(int Id,DateTime CreatedAt,string Customer,string City,decimal Total,decimal Profit,List<SaleLine> Items);private sealed record SaleLine(string ProductName,decimal Quantity,decimal UnitPrice,decimal UnitCost,decimal Profit);private sealed record RouteRow(int Id,string Day,int Position,int CustomerId,string Name,string? TradeName,string City,string Neighborhood);private sealed record ReceivableRow(int Id,int SaleId,string Customer,int InstallmentNumber,DateOnly DueDate,decimal Amount,string PaymentMethod,bool Paid);
}
