@page "/"
@rendermode InteractiveServer
@using System.Net.Http.Headers
@using System.Net.Http.Json
@inject IHttpClientFactory ClientFactory
<PageTitle>VanderBakery | Fornecedor</PageTitle>
<div class="vb-shell">
    <header class="vb-header"><div><span class="vb-brand">Vander<span>Bakery</span></span><small> · Portal da distribuidora</small></div><span class="vb-user">@(_signedIn ? _userName : "Acesso restrito")</span></header>
    @if (!_signedIn)
    {
        <section class="vb-login"><div class="vb-mark">VB</div><p class="eyebrow">ÁREA DO FORNECEDOR</p><h1>Entre para atender<br/>seus pedidos.</h1><label>E-mail</label><input @bind="_email" type="email"/><label>Senha</label><input @bind="_password" type="password"/><button class="vb-primary" @onclick="LoginAsync">Entrar no sistema</button>@if(_message is not null){<p class="vb-note">@_message</p>}<small>Acesso de demonstração: admin@vanderbakery.com · Vander123!</small></section>
    }
    else
    {
        <main class="vb-content">
            <div class="vb-intro"><div><p class="eyebrow">CENTRAL DE OPERAÇÃO</p><h1>Olá, @_userName 👋</h1><p>Pedidos, produtos e clientes da distribuidora em um só lugar.</p></div><button class="vb-outline" @onclick="ReloadTabAsync">↻ Atualizar</button></div>
            <nav class="vb-tabs"><button class='@TabClass("orders")' @onclick='()=>SwitchTabAsync("orders")'>Pedidos</button><button class='@TabClass("catalog")' @onclick='()=>SwitchTabAsync("catalog")'>Produtos e estoque</button><button class='@TabClass("customers")' @onclick='()=>SwitchTabAsync("customers")'>Clientes</button><button class='@TabClass("team")' @onclick='()=>SwitchTabAsync("team")'>Vendedores e regiões</button><button class='@TabClass("finance")' @onclick='()=>SwitchTabAsync("finance")'>Financeiro</button></nav>
            @if(_tab=="orders")
            {
                <div class="vb-stats"><div><span>Pedidos recebidos</span><strong>@_orders.Count(x=>x.Status=="Recebido")</strong></div><div><span>Em corte</span><strong>@_orders.Count(x=>x.Status=="Cortado")</strong></div><div><span>Pedidos listados</span><strong>@_orders.Count</strong></div></div>
                <section class="vb-panel"><div class="vb-panel-head"><div><h2>Pedidos para atendimento</h2><p>Informe as quantidades que serão separadas. O sistema confere o estoque e a validade.</p></div><select @bind="_filter" @bind:after="LoadOrdersAsync"><option value="">Todos os status</option><option>Recebido</option><option>Cortado</option><option>Faturado</option><option>Cancelado</option></select></div>
                    @if(_loading){<p class="vb-empty">Carregando pedidos…</p>}else if(_orders.Count==0){<p class="vb-empty">Nenhum pedido neste filtro.</p>}else{
                    <div class="vb-table-wrap"><table><thead><tr><th>Pedido</th><th>Cliente</th><th>Vendedor</th><th>Data</th><th>Valor pedido</th><th>Status</th><th></th></tr></thead><tbody>@foreach(var order in _orders){<tr><td class="vb-id">#@order.Id.ToString("0000")</td><td>@order.Customer</td><td>@order.Seller</td><td>@order.CreatedAt.ToLocalTime().ToString("dd/MM HH:mm")</td><td>@order.Total.ToString("C")</td><td><span class="vb-status @order.Status.ToLowerInvariant()">@order.Status</span></td><td><button class="vb-link" @onclick="()=>Toggle(order.Id)">@(_expanded==order.Id?"Fechar":"Ver pedido")</button></td></tr>
                    @if(_expanded==order.Id){<tr><td colspan="7"><div class="vb-detail"><strong>Itens do pedido</strong><table><thead><tr><th>Produto</th><th>Pedido</th><th>Preço</th><th>Entrega aprovada</th></tr></thead><tbody>@foreach(var line in order.Items){<tr><td>@line.Product</td><td>@line.Requested</td><td>@line.Price.ToString("C")</td><td><input class="vb-qty" type="number" min="0" max="@line.Requested" @bind="line.Approved" /></td></tr>}</tbody></table>@if(order.Status=="Recebido"){<div class="vb-actions"><button class="vb-primary small" @onclick="()=>CutAsync(order)">Salvar corte</button><span>Não ultrapasse a quantidade pedida ou o estoque.</span></div>}@if(order.Status=="Cortado"){<div class="vb-actions"><button class="vb-primary small" @onclick="()=>InvoiceAsync(order)">Registrar venda e parcelas</button></div>}</div></td></tr>}}</tbody></table></div>}
                </section>
            }
            else if(_tab=="catalog")
            {
                <section class="vb-panel"><h2>Grupos de produtos</h2><div class="vb-form-row"><input @bind="_newGroup" placeholder="Nome do grupo"/><button class="vb-primary small" @onclick="CreateGroupAsync">Adicionar grupo</button></div><p class="vb-hint">@string.Join(" · ",_groups.Select(x=>x.Name))</p></section>
                <section class="vb-panel"><h2>Cadastrar produto e lote</h2><div class="vb-form-grid"><input @bind="_newProduct.Name" placeholder="Nome do produto"/><input @bind="_newProduct.Description" placeholder="Descrição"/><select @bind="_newProduct.GroupId"><option value="0">Grupo</option>@foreach(var g in _groups){<option value="@g.Id">@g.Name</option>}</select><input @bind="_newProduct.Unit" placeholder="Unidade"/><input @bind="_newProduct.Package" placeholder="Embalagem (ex.: 20 L)"/><input @bind="_newProduct.Price" type="number" step="0.01" placeholder="Preço"/><input @bind="_newLot.LotNumber" placeholder="Lote"/><input @bind="_newLot.Quantity" type="number" step="0.01" placeholder="Quantidade"/><input @bind="_newLot.ExpiryDate" type="date" /></div><button class="vb-primary small" @onclick="CreateProductAsync">Salvar produto e estoque</button></section>
                <section class="vb-panel"><div class="vb-panel-head"><div><h2>Catálogo e estoque</h2><p>Disponibilidade soma os lotes ainda válidos.</p></div></div><div class="vb-table-wrap"><table><thead><tr><th>Produto</th><th>Grupo</th><th>Embalagem</th><th>Preço</th><th>Disponível</th><th>Validade próxima</th></tr></thead><tbody>@foreach(var p in _products){<tr><td>@p.Name</td><td>@p.Group</td><td>@p.Package</td><td>@p.Price.ToString("C")</td><td>@p.Available</td><td>@(p.Expiry?.ToString("dd/MM/yyyy")??"—")</td></tr>}</tbody></table></div></section>
            }
            else if(_tab=="customers")
            {
                <section class="vb-panel"><div class="vb-panel-head"><div><h2>Clientes da distribuidora</h2><p>Ajuste a carteira e a ordem de visita do vendedor.</p></div><span class="vb-count">@_customers.Count clientes</span></div>
                    <div class="vb-table-wrap"><table><thead><tr><th>Cliente</th><th>Local</th><th>Vendedor responsável</th><th>Visita</th><th>Regra de atribuição</th><th></th></tr></thead><tbody>@foreach(var c in _customers){<tr><td><strong>@c.Name</strong><br/><small>@c.TaxId</small></td><td>@c.City/@c.State</td><td><select class="vb-select" @bind="c.SellerId"><option value="">Pendente</option>@foreach(var s in _sellers.Where(x=>x.Active)){<option value="@s.Id">@s.Name</option>}</select></td><td><input class="vb-qty" type="number" @bind="c.VisitOrder" /></td><td>@c.AssignmentRule</td><td><button class="vb-link" @onclick="()=>SaveAssignmentAsync(c)">Salvar alterações</button></td></tr>}</tbody></table></div>
                </section>
            }
            else if(_tab=="team")
            {
                <section class="vb-panel"><div class="vb-panel-head"><div><h2>Vendedores</h2><p>Ativar ou desativar o acesso ao app e à carteira.</p></div><span class="vb-count">@_sellers.Count(x=>x.Active) ativos</span></div>
                    <div class="vb-table-wrap"><table><thead><tr><th>Vendedor</th><th>E-mail de acesso</th><th>Regiões atribuídas</th><th>Status</th><th></th></tr></thead><tbody>@foreach(var seller in _sellers){<tr><td><strong>@seller.Name</strong></td><td>@seller.Email</td><td>@(seller.Coverages.Count==0?"Nenhuma região":string.Join(" · ",seller.Coverages.Select(x=>x.City is null?$"Estado {x.State}":$"{x.City}/{x.State}")))</td><td><span class="vb-status @(seller.Active?"ativo":"inativo")">@(seller.Active?"Ativo":"Inativo")</span></td><td><button class="@(seller.Active?"vb-danger":"vb-enable")" @onclick="()=>ToggleSellerAsync(seller)">@(seller.Active?"Desativar":"Ativar")</button></td></tr>}</tbody></table></div>
                </section>
                <section class="vb-panel"><h2>Cadastrar vendedor</h2><p class="vb-section-copy">Crie um acesso para o vendedor usar no aplicativo.</p><div class="vb-form-row"><input @bind="_newSeller.Name" placeholder="Nome do vendedor"/><input @bind="_newSeller.Email" placeholder="E-mail de acesso"/><input @bind="_newSeller.Password" placeholder="Senha inicial" type="password"/><button class="vb-primary small" @onclick="CreateSellerAsync">Cadastrar vendedor</button></div></section>
                <section class="vb-panel"><h2>Atribuir região pronta</h2><p class="vb-section-copy">Escolha um vendedor e uma região. As opções abaixo ficam disponíveis para atribuição e não mudam a carteira até você salvar.</p><div class="vb-form-row"><select @bind="_coverageSellerId"><option value="0">Selecione o vendedor</option>@foreach(var s in _sellers.Where(x=>x.Active)){<option value="@s.Id">@s.Name</option>}</select><select @bind="_coverageTemplateId"><option value="0">Selecione uma região</option>@foreach(var region in _regionOptions){<option value="@region.Id">@region.Name</option>}</select><button class="vb-primary small" @onclick="AddCoverageAsync">Atribuir região</button></div><p class="vb-hint">Cidade específica tem prioridade sobre estado. Em caso de sobreposição, a API escolhe o vendedor com menor carteira e depois o menor ID.</p></section>
            }
            else
            {
                <section class="vb-panel"><div class="vb-panel-head"><div><h2>Contas a receber</h2><p>Encargos ficam registrados como parâmetros; não são calculados automaticamente.</p></div></div><div class="vb-table-wrap"><table><thead><tr><th>Cliente ID</th><th>Venda</th><th>Parcela</th><th>Vencimento</th><th>Valor</th><th>Forma</th><th>Situação</th><th></th></tr></thead><tbody>@foreach(var r in _receivables){<tr><td>@r.CustomerId</td><td>#@r.SaleId</td><td>@r.InstallmentNumber</td><td>@r.DueDate.ToString("dd/MM/yyyy")</td><td>@r.Amount.ToString("C")</td><td>@r.PaymentMethod</td><td>@(r.Paid?"Paga":"Em aberto")</td><td>@if(!r.Paid){<button class="vb-link" @onclick="()=>MarkPaidAsync(r)">Marcar paga</button>}</td></tr>}</tbody></table></div></section>
            }
            @if(_message is not null){<div class="vb-alert">@_message</div>}
        </main>
    }
</div>
@code {
    private HttpClient _api=default!; private string _email="admin@vanderbakery.com",_password="Vander123!",_filter="",_tab="orders",_userName=""; private string? _message; private bool _signedIn,_loading; private int? _expanded; private int _coverageSellerId,_coverageTemplateId; private string _newGroup=""; private List<OrderRow> _orders=[]; private List<ProductRow> _products=[]; private List<GroupRow> _groups=[]; private List<CustomerRow> _customers=[]; private List<SellerRow> _sellers=[]; private List<RegionOptionRow> _regionOptions=[]; private List<ReceivableRow> _receivables=[]; private ProductInput _newProduct=new(); private LotInput _newLot=new(){ExpiryDate=DateOnly.FromDateTime(DateTime.Today.AddMonths(3))}; private SellerInput _newSeller=new();
    protected override void OnInitialized()=>_api=ClientFactory.CreateClient("BakeryApi");
    private async Task LoginAsync(){try{var res=await _api.PostAsJsonAsync("api/auth/login",new{Email=_email,Password=_password});if(!res.IsSuccessStatusCode){_message="E-mail ou senha inválidos.";return;}var data=await res.Content.ReadFromJsonAsync<LoginResult>();if(data?.Role!="Admin"){_message="Acesso permitido somente para funcionário da distribuidora.";return;}_api.DefaultRequestHeaders.Authorization=new AuthenticationHeaderValue("Bearer",data.Token);_userName=data.Name;_signedIn=true;_message=null;await LoadOrdersAsync();}catch{_message="Não foi possível conectar ao sistema da distribuidora.";}}
    private string TabClass(string tab)=>_tab==tab?"vb-tab active":"vb-tab";
    private async Task SwitchTabAsync(string tab){_tab=tab;_message=null;await ReloadTabAsync();}
    private Task ReloadTabAsync()=>_tab switch{"orders"=>LoadOrdersAsync(),"catalog"=>LoadCatalogAsync(),"customers"=>LoadCustomersAsync(),"team"=>LoadTeamAsync(),_=>LoadReceivablesAsync()};
    private async Task LoadOrdersAsync(){if(!_signedIn)return;try{_loading=true;var path=string.IsNullOrEmpty(_filter)?"api/admin/orders":$"api/admin/orders?status={Uri.EscapeDataString(_filter)}";_orders=await _api.GetFromJsonAsync<List<OrderRow>>(path)??[];_message=null;}catch{_message="Não foi possível conectar ao sistema da distribuidora.";}finally{_loading=false;}}
    private async Task LoadCatalogAsync(){try{_groups=await _api.GetFromJsonAsync<List<GroupRow>>("api/admin/groups")??[];_products=await _api.GetFromJsonAsync<List<ProductRow>>("api/products")??[];}catch{_message="Não foi possível carregar produtos e estoque.";}}
    private async Task LoadCustomersAsync(){try{_customers=await _api.GetFromJsonAsync<List<CustomerRow>>("api/admin/customers")??[];_sellers=await _api.GetFromJsonAsync<List<SellerRow>>("api/admin/sellers")??[];}catch{_message="Não foi possível carregar clientes e vendedores.";}}
    private async Task LoadTeamAsync(){try{_sellers=await _api.GetFromJsonAsync<List<SellerRow>>("api/admin/sellers")??[];_regionOptions=await _api.GetFromJsonAsync<List<RegionOptionRow>>("api/admin/region-options")??[];}catch{_message="Não foi possível carregar vendedores e regiões.";}}
    private async Task LoadReceivablesAsync(){try{_receivables=await _api.GetFromJsonAsync<List<ReceivableRow>>("api/receivables")??[];}catch{_message="Não foi possível carregar contas a receber.";}}
    private void Toggle(int id)=>_expanded=_expanded==id?null:id;
    private async Task CutAsync(OrderRow o){try{var res=await _api.PostAsJsonAsync($"api/orders/{o.Id}/cut",new{items=o.Items.Select(x=>new{orderItemId=x.Id,quantity=x.Approved}).ToList()});if(!res.IsSuccessStatusCode){var err=await res.Content.ReadFromJsonAsync<ApiError>();_message=err?.Message??"Não foi possível salvar o corte.";return;}_message="Operação realizada com sucesso.";await LoadOrdersAsync();}catch{_message="Não foi possível conectar ao sistema da distribuidora.";}}
    private async Task InvoiceAsync(OrderRow o){try{var res=await _api.PostAsync($"api/orders/{o.Id}/invoice",null);if(!res.IsSuccessStatusCode){_message="Não foi possível registrar a venda.";return;}_message="Venda e parcelas registradas com sucesso.";await LoadOrdersAsync();}catch{_message="Não foi possível conectar ao sistema da distribuidora.";}}
    private async Task CreateGroupAsync(){if(string.IsNullOrWhiteSpace(_newGroup))return;var res=await _api.PostAsJsonAsync("api/admin/groups",new{Name=_newGroup});_message=res.IsSuccessStatusCode?"Grupo cadastrado.":"Não foi possível cadastrar o grupo.";_newGroup="";await LoadCatalogAsync();}
    private async Task CreateProductAsync(){if(_newProduct.GroupId==0){_message="Selecione o grupo do produto.";return;}var res=await _api.PostAsJsonAsync("api/admin/products",_newProduct);if(!res.IsSuccessStatusCode){_message="Não foi possível cadastrar o produto.";return;}var created=await res.Content.ReadFromJsonAsync<CreatedRow>();var lotRes=await _api.PostAsJsonAsync($"api/admin/products/{created!.Id}/lots",_newLot);_message=lotRes.IsSuccessStatusCode?"Produto e lote cadastrados com sucesso.":"Produto cadastrado, mas o lote não foi salvo.";_newProduct=new();_newLot=new(){ExpiryDate=DateOnly.FromDateTime(DateTime.Today.AddMonths(3))};await LoadCatalogAsync();}
    private async Task CreateSellerAsync(){var res=await _api.PostAsJsonAsync("api/admin/sellers",_newSeller);_message=res.IsSuccessStatusCode?"Vendedor cadastrado com sucesso.":"Não foi possível cadastrar o vendedor.";_newSeller=new();await LoadTeamAsync();}
    private async Task ToggleSellerAsync(SellerRow seller){var active=!seller.Active;var res=await _api.PutAsJsonAsync($"api/admin/sellers/{seller.Id}",new{Name=seller.Name,Email=seller.Email,Active=active});if(res.IsSuccessStatusCode){seller.Active=active;_message=active?"Vendedor ativado. Já pode entrar no aplicativo.":"Vendedor desativado. O acesso ao aplicativo foi bloqueado.";}else _message="Não foi possível atualizar o status do vendedor.";}
    private async Task AddCoverageAsync(){if(_coverageSellerId==0||_coverageTemplateId==0){_message="Selecione o vendedor e a região.";return;}var region=_regionOptions.First(x=>x.Id==_coverageTemplateId);var seller=_sellers.First(x=>x.Id==_coverageSellerId);if(seller.Coverages.Any(x=>x.City==region.City&&x.State==region.State)){_message="Essa região já está atribuída a esse vendedor.";return;}var res=await _api.PostAsJsonAsync($"api/admin/sellers/{_coverageSellerId}/coverages",new{city=region.City,state=region.State});_message=res.IsSuccessStatusCode?"Região atribuída ao vendedor.":"Não foi possível atribuir a região.";await LoadTeamAsync();}
    private async Task SaveAssignmentAsync(CustomerRow c){var res=await _api.PutAsJsonAsync($"api/admin/customers/{c.Id}/assignment",new{sellerId=c.SellerId,visitOrder=c.VisitOrder});_message=res.IsSuccessStatusCode?"Operação realizada com sucesso.":"Não foi possível salvar a carteira.";}
    private async Task MarkPaidAsync(ReceivableRow r){var res=await _api.PutAsJsonAsync($"api/admin/receivables/{r.Id}/paid",new{paid=true});_message=res.IsSuccessStatusCode?"Operação realizada com sucesso.":"Não foi possível atualizar a parcela.";await LoadReceivablesAsync();}
    private sealed class LoginResult{public string Token{get;set;}="";public string Name{get;set;}="";public string Role{get;set;}="";} private sealed class ApiError{public string? Message{get;set;}}
    private sealed class OrderRow{public int Id{get;set;}public string? Customer{get;set;}public string? Seller{get;set;}public string Status{get;set;}="";public DateTime CreatedAt{get;set;}public decimal Total{get;set;}public List<ItemRow> Items{get;set;}=[];} private sealed class ItemRow{public int Id{get;set;}public string? Product{get;set;}public decimal RequestedQuantity{get;set;}public decimal ApprovedQuantity{get;set;}public decimal UnitPrice{get;set;}public decimal Requested=>RequestedQuantity;public decimal Price=>UnitPrice;public decimal Approved{get=>ApprovedQuantity;set=>ApprovedQuantity=value;}}
    private sealed class GroupRow{public int Id{get;set;}public string Name{get;set;}="";} private sealed class ProductRow{public string Name{get;set;}="";public string Group{get;set;}="";public string Package{get;set;}="";public decimal Price{get;set;}public decimal Available{get;set;}public DateOnly? Expiry{get;set;}} private sealed class CreatedRow{public int Id{get;set;}}
    private sealed class ProductInput{public string Name{get;set;}="";public string Description{get;set;}="";public int GroupId{get;set;}public string Unit{get;set;}="un";public string Package{get;set;}="";public decimal Price{get;set;}} private sealed class LotInput{public string LotNumber{get;set;}="";public decimal Quantity{get;set;}public DateOnly ExpiryDate{get;set;}}
    private sealed class SellerInput{public string Name{get;set;}="";public string Email{get;set;}="";public string Password{get;set;}="";} private sealed class CoverageInput{public string? City{get;set;}public string State{get;set;}="";}
    private sealed class SellerRow{public int Id{get;set;}public string Name{get;set;}="";public string Email{get;set;}="";public bool Active{get;set;}public List<CoverageRow> Coverages{get;set;}=[];} private sealed class CoverageRow{public string? City{get;set;}public string State{get;set;}="";} private sealed class RegionOptionRow{public int Id{get;set;}public string Name{get;set;}="";public string? City{get;set;}public string State{get;set;}="";} private sealed class CustomerRow{public int Id{get;set;}public string Name{get;set;}="";public string TaxId{get;set;}="";public string City{get;set;}="";public string State{get;set;}="";public int VisitOrder{get;set;}public int? SellerId{get;set;}public string AssignmentRule{get;set;}="";}
    private sealed class ReceivableRow{public int Id{get;set;}public int SaleId{get;set;}public int CustomerId{get;set;}public int InstallmentNumber{get;set;}public DateOnly DueDate{get;set;}public decimal Amount{get;set;}public string PaymentMethod{get;set;}="";public bool Paid{get;set;}}
}
