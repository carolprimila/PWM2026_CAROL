<div class="col-6 col-lg-3">
    <div class="card h-100"><div class="card-body">
        <div class="small text-secondary mb-2">@Rotulo</div>
        <span class="indicador">@Valor</span>
        @if (Detalhe is not null) { <span class="small text-secondary ms-1">@Detalhe</span> }
    </div></div>
</div>

@code {
    [Parameter] public string Rotulo { get; set; } = "";
    [Parameter] public int Valor { get; set; }
    [Parameter] public string? Detalhe { get; set; }
}
