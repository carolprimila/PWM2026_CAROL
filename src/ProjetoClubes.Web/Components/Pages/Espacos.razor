@page "/reservas/espacos"
@inject Api Api
@inject Sessao Sessao

<PageTitle>Espaços · Projeto Clubes</PageTitle>

<a href="reservas" class="small text-secondary text-decoration-none">← Reservas</a>
<h1 class="h3 mt-2 mb-3">Espaços</h1>

@if (_erro is not null) { <div class="alert alert-danger">@_erro</div> }

@if (Sessao.Possui("espacos.gerenciar"))
{
    <form class="card mb-3" @onsubmit="Criar"><div class="card-body">
        <h2 class="h6 mb-3">Novo espaço</h2>
        <div class="row g-2">
            <div class="col-12 col-md-4"><input class="form-control" placeholder="Nome" @bind="_nome" aria-label="Nome" /></div>
            <div class="col-12 col-md-3">
                <select class="form-select" @bind="_tipo" aria-label="Tipo">
                    @foreach (var t in Tipos) { <option value="@t">@Rotulos.Texto(t)</option> }
                </select>
            </div>
            <div class="col-4 col-md-1"><input type="number" min="1" class="form-control" placeholder="Pessoas" @bind="_capacidade" aria-label="Capacidade" /></div>
            <div class="col-4 col-md-2"><input type="number" min="0" step="0.01" class="form-control" placeholder="Locação (R$)" @bind="_valor" aria-label="Valor de locação" /></div>
            <div class="col-4 col-md-2"><input type="number" min="0" step="0.01" class="form-control" placeholder="Taxa (R$)" @bind="_taxa" aria-label="Taxa adicional" /></div>
            <div class="col-12 col-md-4"><input type="number" min="1" class="form-control" placeholder="Limite de reservas por família/mês (vazio = sem limite)" @bind="_limite" aria-label="Limite de reservas por mês" /></div>
        </div>
        <div class="d-flex justify-content-between align-items-center mt-2">
            <div class="form-check"><input class="form-check-input" type="checkbox" id="aprov" @bind="_exigeAprovacao" />
                <label class="form-check-label small" for="aprov">Reservas pelo app precisam de aprovação</label></div>
            <button class="btn btn-dark" type="submit">Adicionar</button>
        </div>
    </div></form>
}

<div class="card"><div class="table-responsive">
    <table class="table mb-0 align-middle">
        <thead><tr><th>Espaço</th><th>Capacidade</th><th class="text-end">Locação</th><th>Aprovação</th><th>Limite por mês</th></tr></thead>
        <tbody>
        @foreach (var e in _espacos)
        {
            <tr><td><div class="fw-medium">@e.Nome</div><small class="text-secondary">@Rotulos.Texto(e.Tipo)</small></td>
                <td>@(e.Capacidade?.ToString() ?? "—")</td>
                <td class="text-end text-nowrap">@Rotulos.Moeda(e.ValorLocacao + e.TaxaAdicional)</td>
                <td>@(e.ExigeAprovacao ? "Necessária" : "Automática")</td>
                <td style="max-width:150px">
                    @if (Sessao.Possui("espacos.gerenciar"))
                    {
                        <input type="number" min="1" class="form-control form-control-sm" placeholder="sem limite" value="@e.LimiteReservasPorMes"
                               @onchange="v => SalvarLimite(e, v.Value?.ToString())" aria-label="Limite de reservas por mês" />
                    }
                    else { @(e.LimiteReservasPorMes?.ToString() ?? "Sem limite") }
                </td></tr>
        }
        @if (_espacos.Count == 0) { <tr><td colspan="5" class="text-secondary">Nenhum espaço cadastrado.</td></tr> }
        </tbody>
    </table>
</div></div>

@code {
    private static readonly string[] Tipos = ["SalaoSocial", "Quiosque", "Churrasqueira", "Quadra", "CampoFutebol", "Piscina", "Camping", "SalaReuniao", "Outro"];
    private List<EspacoInfo> _espacos = [];
    private string _nome = "", _tipo = "SalaoSocial";
    private int? _capacidade, _limite;
    private decimal _valor, _taxa;
    private bool _exigeAprovacao = true;
    private string? _erro;

    protected override Task OnInitializedAsync() => Carregar();

    private async Task Carregar()
    {
        try { _espacos = await Api.GetAsync<List<EspacoInfo>>("api/v1/espacos?incluirInativos=true"); }
        catch (ErroApi e) { _erro = e.Message; }
    }

    private async Task Criar()
    {
        _erro = null;
        try
        {
            await Api.PostAsync("api/v1/espacos", new { nome = _nome, tipo = _tipo, capacidade = _capacidade, valorLocacao = _valor, taxaAdicional = _taxa, exigeAprovacao = _exigeAprovacao, limiteReservasPorMes = _limite });
            _nome = "";
            await Carregar();
        }
        catch (ErroApi e) { _erro = e.Message; }
    }

    /// <summary>Limite mensal de reservas por família nos espaços deste tipo (vale para pedidos feitos pelo app).</summary>
    private async Task SalvarLimite(EspacoInfo e, string? valor)
    {
        _erro = null;
        int? limite = int.TryParse(valor, out var n) ? n : null;
        try
        {
            await Api.PutAsync<System.Text.Json.JsonElement>($"api/v1/espacos/{e.Id}", new
            {
                nome = e.Nome, tipo = e.Tipo, descricao = e.Descricao, capacidade = e.Capacidade, valorLocacao = e.ValorLocacao,
                taxaAdicional = e.TaxaAdicional, exigeAprovacao = e.ExigeAprovacao, regras = e.Regras, ativo = e.Ativo,
                limiteReservasPorMes = limite,
            });
            await Carregar();
        }
        catch (ErroApi ex) { _erro = ex.Message; }
    }
}
