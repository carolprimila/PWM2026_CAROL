@page "/perfis"
@inject Api Api
@inject Sessao Sessao

<PageTitle>Perfis e permissões · Projeto Clubes</PageTitle>

<a href="usuarios" class="small text-secondary text-decoration-none">← Usuários</a>
<h1 class="h3 mt-2 mb-1">Perfis e permissões</h1>
<p class="text-secondary mb-3">Cada perfil reúne permissões. Você só consegue conceder permissões que você mesmo tem.</p>

@if (_mensagem is not null) { <div class="alert alert-success">@_mensagem</div> }
@if (_erro is not null) { <div class="alert alert-danger">@_erro</div> }

<div class="row g-3">
    <div class="col-12 col-lg-4">
        <div class="list-group mb-3">
            @foreach (var p in _perfis)
            {
                <button class="list-group-item list-group-item-action d-flex justify-content-between align-items-center @(p.Id == _selecionado?.Id ? "active" : "")"
                        @onclick="() => Selecionar(p)">
                    <span>@p.Nome@(p.Padrao ? " (padrão)" : "")</span>
                    <span class="badge text-bg-light">@p.TotalUsuarios usuário(s)</span>
                </button>
            }
        </div>
        @if (Gerencia)
        {
            <form class="card" @onsubmit="Criar"><div class="card-body">
                <h2 class="h6">Novo perfil</h2>
                <input class="form-control mb-2" placeholder="Nome (ex.: Tesouraria auxiliar)" @bind="_novoNome" aria-label="Nome do perfil" />
                <button class="btn btn-dark w-100" type="submit">Criar</button>
            </div></form>
        }
    </div>
    <div class="col-12 col-lg-8">
        @if (_selecionado is { } s)
        {
            <div class="card"><div class="card-body">
                <div class="d-flex justify-content-between align-items-start gap-2 mb-3">
                    <div class="flex-grow-1">
                        <input class="form-control fw-medium mb-1" @bind="_nome" disabled="@(!Gerencia)" aria-label="Nome do perfil" />
                        <input class="form-control form-control-sm" placeholder="Descrição" @bind="_descricao" disabled="@(!Gerencia)" aria-label="Descrição" />
                    </div>
                    @if (Gerencia && !s.Padrao && s.TotalUsuarios == 0) { <button class="btn btn-outline-danger btn-sm" @onclick="Excluir">Excluir</button> }
                </div>
                @foreach (var m in _catalogo)
                {
                    <div class="mb-3">
                        <div class="fw-medium small text-uppercase text-secondary mb-1">@m.Modulo</div>
                        @foreach (var item in m.Permissoes)
                        {
                            var podeConceder = Sessao.Possui(item.Codigo);
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="@item.Codigo" checked="@_marcadas.Contains(item.Codigo)"
                                       disabled="@(!Gerencia || (!podeConceder && !_marcadas.Contains(item.Codigo)))"
                                       @onchange="e => Alternar(item.Codigo, (bool)e.Value!)" />
                                <label class="form-check-label small" for="@item.Codigo">@item.Descricao</label>
                            </div>
                        }
                    </div>
                }
                @if (Gerencia) { <button class="btn btn-dark" @onclick="Salvar">Salvar perfil</button> }
            </div></div>
        }
        else { <div class="card"><div class="card-body text-secondary">Escolha um perfil para ver as permissões.</div></div> }
    </div>
</div>

@code {
    private List<PerfilDetalhe> _perfis = [];
    private List<ModuloPermissoes> _catalogo = [];
    private PerfilDetalhe? _selecionado;
    private HashSet<string> _marcadas = [];
    private string _nome = "", _descricao = "", _novoNome = "";
    private string? _erro, _mensagem;
    private bool Gerencia => Sessao.Possui("perfis.gerenciar");

    protected override async Task OnInitializedAsync()
    {
        try { _catalogo = await Api.GetAsync<List<ModuloPermissoes>>("api/v1/permissoes"); }
        catch (ErroApi e) { _erro = e.Message; }
        await Carregar(null);
    }

    private async Task Carregar(Guid? selecionar)
    {
        try
        {
            _perfis = await Api.GetAsync<List<PerfilDetalhe>>("api/v1/perfis");
            var alvo = _perfis.FirstOrDefault(p => p.Id == (selecionar ?? _selecionado?.Id)) ?? _perfis.FirstOrDefault();
            if (alvo is not null) Selecionar(alvo);
        }
        catch (ErroApi e) { _erro = e.Message; }
    }

    private void Selecionar(PerfilDetalhe p)
    {
        _selecionado = p;
        _nome = p.Nome;
        _descricao = p.Descricao ?? "";
        _marcadas = p.Permissoes.ToHashSet();
    }

    private void Alternar(string codigo, bool marcar)
    {
        if (marcar) _marcadas.Add(codigo); else _marcadas.Remove(codigo);
    }

    private async Task Salvar()
    {
        if (_selecionado is null) return;
        _erro = _mensagem = null;
        try
        {
            await Api.PutAsync<PerfilDetalhe>($"api/v1/perfis/{_selecionado.Id}", new { nome = _nome, descricao = _descricao, permissoes = _marcadas.ToList() });
            _mensagem = $"Perfil \"{_nome}\" salvo. Quem usa este perfil recebe as mudanças no próximo minuto.";
            await Carregar(_selecionado.Id);
        }
        catch (ErroApi e) { _erro = e.Message; }
    }

    private async Task Criar()
    {
        _erro = _mensagem = null;
        try
        {
            var p = await Api.PostAsync<PerfilDetalhe>("api/v1/perfis", new { nome = _novoNome, descricao = (string?)null, permissoes = Array.Empty<string>() });
            _novoNome = "";
            _mensagem = "Perfil criado. Marque as permissões e salve.";
            await Carregar(p.Id);
        }
        catch (ErroApi e) { _erro = e.Message; }
    }

    private async Task Excluir()
    {
        if (_selecionado is null) return;
        _erro = _mensagem = null;
        try { await Api.DeleteAsync($"api/v1/perfis/{_selecionado.Id}"); _selecionado = null; _mensagem = "Perfil excluído."; await Carregar(null); }
        catch (ErroApi e) { _erro = e.Message; }
    }
}
