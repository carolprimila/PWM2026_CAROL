@page "/financeiro"
@inject Api Api
@inject Sessao Sessao

<PageTitle>Financeiro · Projeto Clubes</PageTitle>

<h1 class="h3 mb-3">Financeiro</h1>
<AbasFinanceiro />

@if (_mensagem is not null) { <div class="alert alert-success">@_mensagem</div> }
@if (_erro is not null) { <div class="alert alert-danger">@_erro</div> }

@if (_resumo is { } r)
{
    <div class="row g-3 mb-4">
        <div class="col-6 col-lg-3"><div class="card h-100"><div class="card-body">
            <div class="small text-secondary mb-2">Recebido no mês</div>
            <div class="fs-4 fw-semibold">@Rotulos.Moeda(r.ReceitasMensalidades + r.OutrasReceitas)</div>
        </div></div></div>
        <div class="col-6 col-lg-3"><div class="card h-100"><div class="card-body">
            <div class="small text-secondary mb-2">Despesas pagas no mês</div>
            <div class="fs-4 fw-semibold">@Rotulos.Moeda(r.Despesas)</div>
        </div></div></div>
        <div class="col-6 col-lg-3"><div class="card h-100"><div class="card-body">
            <div class="small text-secondary mb-2">Saldo do mês</div>
            <div class="fs-4 fw-semibold @(r.Saldo < 0 ? "text-danger" : "")">@Rotulos.Moeda(r.Saldo)</div>
        </div></div></div>
        <div class="col-6 col-lg-3"><div class="card h-100"><div class="card-body">
            <div class="small text-secondary mb-2">Inadimplência</div>
            <div class="fs-4 fw-semibold text-danger">@Rotulos.Moeda(r.Inadimplencia.Valor)</div>
            <div class="small text-secondary">@r.Inadimplencia.Associados associado(s) · @r.Inadimplencia.Mensalidades mensalidade(s)</div>
        </div></div></div>
    </div>
}

<div class="d-flex gap-2 flex-wrap align-items-end mb-3">
    <div>
        <label class="form-label small mb-1" for="comp">Competência</label>
        <input id="comp" type="month" class="form-control" @bind="_mes" @bind:format="yyyy-MM" @bind:after="Carregar" />
    </div>
    <div>
        <label class="form-label small mb-1" for="sit">Situação</label>
        <select id="sit" class="form-select" @bind="_situacao" @bind:after="Carregar">
            <option value="">Todas</option>
            <option value="Aberta">Em aberto</option>
            <option value="Vencida">Vencidas</option>
            <option value="Paga">Pagas</option>
            <option value="Isenta">Isentas</option>
            <option value="Cancelada">Canceladas</option>
        </select>
    </div>
    <div class="flex-grow-1">
        <label class="form-label small mb-1" for="busca">Associado</label>
        <input id="busca" class="form-control" placeholder="Nome ou matrícula" @bind="_busca" @bind:event="oninput" @bind:after="Carregar" />
    </div>
    @if (Sessao.Possui("financeiro.gerenciar"))
    {
        <button class="btn btn-dark" @onclick="Gerar" disabled="@_ocupado">Gerar mensalidades de @_competencia</button>
    }
</div>

@if (_pagando is { } m)
{
    <div class="card mb-3 border-dark"><div class="card-body">
        <h2 class="h6">Registrar pagamento — @m.AssociadoNome (@m.Competencia)</h2>
        <div class="small text-secondary mb-2">
            Valor @Rotulos.Moeda(m.Valor)@(m.Encargos > 0 ? $" + {Rotulos.Moeda(m.Encargos)} de multa e juros = {Rotulos.Moeda(m.ValorAtualizado)}" : "")
        </div>
        <div class="d-flex gap-2 flex-wrap align-items-center">
            <select class="form-select" style="max-width:220px" @bind="_forma" aria-label="Forma de pagamento">
                @foreach (var f in Rotulos.FormasPagamento) { <option value="@f">@Rotulos.Forma(f)</option> }
            </select>
            <input type="date" class="form-control" style="max-width:180px" @bind="_dataPagamento" aria-label="Data do pagamento" />
            @if (m.Encargos > 0)
            {
                <div class="form-check"><input class="form-check-input" type="checkbox" id="isentar" @bind="_isentarEncargos" />
                    <label class="form-check-label small" for="isentar">Dispensar multa e juros</label></div>
            }
            <button class="btn btn-success" @onclick="ConfirmarPagamento" disabled="@_ocupado">Confirmar recebimento</button>
            <button class="btn btn-link" @onclick="() => _pagando = null">Cancelar</button>
        </div>
    </div></div>
}

@if (_pagina is null) { <p class="text-secondary">Carregando…</p> }
else if (_pagina.TotalItens == 0)
{
    <div class="card"><div class="card-body text-center text-secondary py-5">
        Nenhuma mensalidade para este filtro.
        @if (Sessao.Possui("financeiro.gerenciar")) { <div class="small mt-1">Cadastre os planos em “Planos e regras” e use “Gerar mensalidades”.</div> }
    </div></div>
}
else
{
    <div class="card"><div class="table-responsive">
        <table class="table mb-0 align-middle">
            <thead><tr><th>Associado</th><th>Competência</th><th class="d-none d-md-table-cell">Vencimento</th><th class="text-end">Valor</th><th>Situação</th><th></th></tr></thead>
            <tbody>
            @foreach (var x in _pagina.Itens)
            {
                <tr>
                    <td><a href="associados/@x.AssociadoId" class="fw-medium text-decoration-none">@x.AssociadoNome</a><div class="small text-secondary">@x.Matricula@(x.QuantidadeDependentes > 0 ? $" · {x.QuantidadeDependentes} dependente(s)" : "")</div></td>
                    <td>@x.Competencia</td>
                    <td class="d-none d-md-table-cell">@x.Vencimento.ToString("dd/MM/yyyy")</td>
                    <td class="text-end text-nowrap">
                        @if (x.Pagamento is { } pago)
                        {
                            @Rotulos.Moeda(pago.Valor)
                            @if (pago.Encargos > 0) { <div class="small text-secondary">inclui @Rotulos.Moeda(pago.Encargos) de encargos</div> }
                        }
                        else
                        {
                            @Rotulos.Moeda(x.ValorAtualizado)
                            @if (x.Encargos > 0) { <div class="small text-danger">+@Rotulos.Moeda(x.Encargos) encargos</div> }
                        }
                    </td>
                    <td><Situacao Valor="@x.Situacao" />@if (x.Pagamento is { } p) { <div class="small text-secondary">recibo nº @p.NumeroRecibo · @Rotulos.Forma(p.Forma)</div> }</td>
                    <td class="text-end text-nowrap">
                        @if (x.Situacao is "Aberta" or "Vencida" && Sessao.Possui("financeiro.registrar_pagamentos"))
                        {
                            <button class="btn btn-sm btn-outline-success" @onclick="() => Pagar(x)">Receber</button>
                        }
                        @if (x.Pagamento is { } pg && Sessao.Possui("financeiro.gerenciar"))
                        {
                            <button class="btn btn-sm btn-outline-secondary" @onclick="() => Estornar(pg)">Estornar</button>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
    <div class="card-footer bg-white small text-secondary">@_pagina.TotalItens mensalidade(s)</div></div>
}

@code {
    private ResumoFinanceiro? _resumo;
    private Pagina<Mensalidade>? _pagina;
    private DateTime _mes = new(DateTime.Today.Year, DateTime.Today.Month, 1);
    private string _competencia => _mes.ToString("yyyy-MM");
    private string _situacao = "";
    private string _busca = "";
    private Mensalidade? _pagando;
    private string _forma = "Pix";
    private DateOnly _dataPagamento = DateOnly.FromDateTime(DateTime.Today);
    private bool _isentarEncargos;
    private bool _ocupado;
    private string? _erro, _mensagem;

    protected override async Task OnInitializedAsync() { await CarregarResumo(); await Carregar(); }

    private async Task CarregarResumo()
    {
        try { _resumo = await Api.GetAsync<ResumoFinanceiro>("api/v1/financeiro/resumo"); }
        catch (ErroApi e) { _erro = e.Message; }
    }

    private async Task Carregar()
    {
        try
        {
            _pagina = await Api.GetAsync<Pagina<Mensalidade>>(
                $"api/v1/financeiro/mensalidades?tamanhoPagina=100&competencia={_competencia}&situacao={_situacao}&busca={Uri.EscapeDataString(_busca)}");
        }
        catch (ErroApi e) { _erro = e.Message; }
    }

    private async Task Gerar()
    {
        _erro = _mensagem = null;
        _ocupado = true;
        try
        {
            var r = await Api.PostAsync<GerarResultado>("api/v1/financeiro/mensalidades/gerar", new { competencia = _competencia });
            _mensagem = $"{r.Geradas} mensalidade(s) gerada(s) ({Rotulos.Moeda(r.ValorTotal)})"
                + (r.JaExistentes > 0 ? $"; {r.JaExistentes} já existiam" : "")
                + (r.SemPlano.Count > 0 ? $". Sem plano para a categoria: {string.Join(", ", r.SemPlano)}." : ".");
            await CarregarResumo();
            await Carregar();
        }
        catch (ErroApi e) { _erro = e.Message; }
        finally { _ocupado = false; }
    }

    private void Pagar(Mensalidade m)
    {
        _pagando = m;
        _isentarEncargos = false;
        _dataPagamento = DateOnly.FromDateTime(DateTime.Today);
    }

    private async Task ConfirmarPagamento()
    {
        _erro = _mensagem = null;
        _ocupado = true;
        try
        {
            var m = await Api.PostAsync<Mensalidade>($"api/v1/financeiro/mensalidades/{_pagando!.Id}/pagamento",
                new { forma = _forma, data = _dataPagamento, isentarEncargos = _isentarEncargos });
            _mensagem = $"Pagamento de {m.AssociadoNome} registrado. Recibo nº {m.Pagamento?.NumeroRecibo}.";
            _pagando = null;
            await CarregarResumo();
            await Carregar();
        }
        catch (ErroApi e) { _erro = e.Message; }
        finally { _ocupado = false; }
    }

    private async Task Estornar(PagamentoResumo p)
    {
        _erro = _mensagem = null;
        try
        {
            await Api.PostAsync($"api/v1/financeiro/pagamentos/{p.Id}/estornar", new { motivo = "Estornado pela tesouraria" });
            _mensagem = $"Pagamento do recibo nº {p.NumeroRecibo} estornado.";
            await CarregarResumo();
            await Carregar();
        }
        catch (ErroApi e) { _erro = e.Message; }
    }
}
