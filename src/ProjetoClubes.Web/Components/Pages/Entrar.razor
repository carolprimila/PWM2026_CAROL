@page "/entrar"
@layout LayoutAcesso
@inject Api Api
@inject NavigationManager Nav
@inject IConfiguration Config

<PageTitle>Entrar · Projeto Clubes</PageTitle>

<h1 class="h4 mb-1">Entrar</h1>
<p class="text-secondary small mb-4">Use o e-mail e a senha cadastrados pela administração do clube.</p>

@if (_erro is not null) { <div class="alert alert-danger py-2">@_erro</div> }

@if (_clubes is { } clubes)
{
    <p class="small mb-2">Você tem acesso a mais de um clube. Em qual deseja entrar?</p>
    <div class="d-grid gap-2">
        @foreach (var c in clubes)
        {
            <button type="button" class="btn btn-outline-dark text-start" disabled="@_enviando" @onclick="() => EscolherClubeAsync(c.Id)">
                <span class="fw-medium">@(c.NomeExibicao ?? c.Nome)</span> <span class="text-secondary small">@c.Sigla</span>
            </button>
        }
    </div>
    return;
}

<form @onsubmit="EntrarAsync">
    <div class="mb-3">
        <label class="form-label" for="email">E-mail</label>
        <input id="email" type="email" class="form-control" @bind="_email" autocomplete="username" required autofocus />
    </div>
    <div class="mb-4">
        <label class="form-label" for="senha">Senha</label>
        <input id="senha" type="password" class="form-control" @bind="_senha" autocomplete="current-password" required />
    </div>
    <button class="btn btn-dark w-100" type="submit" disabled="@_enviando">@(_enviando ? "Entrando…" : "Entrar")</button>
</form>

@if (_demo is { Contas.Count: > 0 } demo)
{
    <div class="border rounded p-3 mt-3 bg-light">
        <div class="small text-secondary mb-2">Ambiente de desenvolvimento — entrar com uma conta de demonstração:</div>
        <div class="d-flex flex-wrap gap-2">
            @foreach (var c in demo.Contas)
            {
                <button type="button" class="btn btn-sm btn-outline-dark" disabled="@_enviando" @onclick="() => EntrarComoAsync(c.Email)">@c.Nome</button>
            }
        </div>
    </div>
}

<div class="text-center mt-3">
    @if (!_recuperar) { <button type="button" class="btn btn-link btn-sm text-secondary" @onclick="() => _recuperar = true">Esqueci minha senha</button> }
    else if (_recuperacaoEnviada) { <div class="alert alert-success py-2 small text-start">Se o e-mail estiver cadastrado, você receberá um link para criar uma nova senha.</div> }
    else
    {
        <div class="text-start small text-secondary mb-2">Informe o e-mail acima e enviaremos um link para criar uma nova senha.</div>
        <button type="button" class="btn btn-outline-dark btn-sm w-100" @onclick="RecuperarAsync" disabled="@_enviando">Enviar link</button>
    }
</div>

@code {
    /// <summary>Página que a pessoa tentou abrir antes do login (só caminhos deste site).</summary>
    [SupplyParameterFromQuery] public string? Voltar { get; set; }
    private string Destino => Voltar is { Length: > 1 } v && v.StartsWith('/') && !v.StartsWith("//") ? v[1..] : "";

    private string _email = "";
    private string _senha = "";
    private string? _erro;
    private bool _enviando, _recuperar, _recuperacaoEnviada;

    private sealed class ContaDemo { public string Nome { get; set; } = ""; public string Email { get; set; } = ""; }
    private sealed class LoginDemo { public string Senha { get; set; } = ""; public List<ContaDemo> Contas { get; set; } = []; }
    private LoginDemo? _demo;

    // A seção LoginDemonstracao só existe em appsettings.Development.json: em produção a tela fica vazia.
    protected override void OnInitialized()
    {
        _demo = Config.GetSection("LoginDemonstracao").Get<LoginDemo>();
        if (_demo is { Contas.Count: > 0 })
        {
            _email = _demo.Contas[0].Email;
            _senha = _demo.Senha;
        }
    }

    private List<ClubeResumo>? _clubes;

    private async Task EscolherClubeAsync(Guid clubeId)
    {
        _erro = null;
        _enviando = true;
        try { await Api.TrocarClubeAsync(clubeId); Nav.NavigateTo(Destino); }
        catch (ErroApi e) { _erro = e.Message; }
        finally { _enviando = false; }
    }

    private async Task EntrarComoAsync(string email)
    {
        _email = email;
        _senha = _demo!.Senha;
        await EntrarAsync();
    }

    private async Task RecuperarAsync()
    {
        _erro = null;
        if (string.IsNullOrWhiteSpace(_email)) { _erro = "Informe o e-mail."; return; }
        _enviando = true;
        try { await Api.PostAsync("api/v1/auth/esqueci-senha", new { email = _email.Trim() }); _recuperacaoEnviada = true; }
        catch (ErroApi e) { _erro = e.Message; }
        finally { _enviando = false; }
    }

    private async Task EntrarAsync()
    {
        _erro = null;
        _enviando = true;
        try
        {
            var t = await Api.EntrarAsync(_email.Trim(), _senha);
            // Quem participa de mais de um clube escolhe em qual entrar.
            if (t.Usuario.Clubes.Count > 1) { _clubes = t.Usuario.Clubes; return; }
            Nav.NavigateTo(Destino);
        }
        catch (ErroApi e) { _erro = e.Message; }
        finally { _enviando = false; }
    }
}
