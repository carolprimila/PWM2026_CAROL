{
  "ConnectionStrings": {
    "Default": "Data Source=projetoclubes.db"
  },
  "Jwt": {
    "Emissor": "ProjetoClubes",
    "Audiencia": "ProjetoClubes.Clientes",
    "Chave": "",
    "MinutosAccessToken": 15,
    "DiasRefreshToken": 14
  },
  "Autenticacao": {
    "MaxTentativasFalhas": 5,
    "MinutosBloqueio": 15,
    "MinutosValidadeTokenRecuperacao": 60,
    "UrlRedefinicaoSenha": "http://localhost:5278/redefinir-senha"
  },
  "Banco": {
    "AplicarMigrationsAoIniciar": true
  },
  "Seed": {
    "Demo": false,
    "SenhaDemo": ""
  },
  "Setup": {
    "Token": ""
  },
  "Email": {
    "Provedor": "Arquivo",
    "PastaSaida": "App_Data/emails",
    "Remetente": "nao-responda@projetoclubes.local"
  },
  "Arquivos": {
    "Pasta": "App_Data/arquivos"
  },
  "Cors": {
    "Origens": []
  },
  "LimiteRequisicoes": {
    "AutenticacaoPorMinuto": 20
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
