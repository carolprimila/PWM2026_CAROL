<?xml version="1.0" encoding="utf-8" ?>
<v:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
            xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
            xmlns:c="clr-namespace:Clubes.Mobile.Controls"
            xmlns:m="clr-namespace:Clubes.Mobile.Models"
            xmlns:s="clr-namespace:Clubes.Mobile.Services"
            xmlns:v="clr-namespace:Clubes.Mobile.Views"
            xmlns:vm="clr-namespace:Clubes.Mobile.ViewModels"
            x:Class="Clubes.Mobile.Views.ChangePasswordPage" x:DataType="vm:ChangePasswordViewModel" Title="Alterar senha">
    <ScrollView>
        <VerticalStackLayout Style="{StaticResource PageStack}">
            <Border Style="{StaticResource WarningBanner}" IsVisible="{Binding Forced}">
                <Label Text="Por segurança, crie uma nova senha antes de continuar. A senha atual é a senha temporária que você recebeu." TextColor="{StaticResource Warning}" />
            </Border>
            <c:FormField Label="Senha atual" Text="{Binding Current}" IsPassword="True" Error="{Binding CurrentError}" />
            <c:FormField Label="Nova senha" Text="{Binding NewPassword}" IsPassword="True" Error="{Binding PasswordError}" />
            <c:FormField Label="Confirmar nova senha" Text="{Binding Confirm}" IsPassword="True" Error="{Binding ConfirmError}" />
            <Label Text="Use ao menos 8 caracteres, com letras e números. Ao alterar a senha, as sessões em outros aparelhos são encerradas." Style="{StaticResource Muted}" />
            <Button Text="Salvar nova senha" Command="{Binding SaveCommand}" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
            <Button Text="Sair" Style="{StaticResource TextButton}" Command="{Binding LogoutCommand}" IsVisible="{Binding Forced}" />
        </VerticalStackLayout>
    </ScrollView>
</v:BasePage>
