<?xml version="1.0" encoding="utf-8" ?>
<v:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
            xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
            xmlns:c="clr-namespace:Clubes.Mobile.Controls"
            xmlns:m="clr-namespace:Clubes.Mobile.Models"
            xmlns:s="clr-namespace:Clubes.Mobile.Services"
            xmlns:v="clr-namespace:Clubes.Mobile.Views"
            xmlns:vm="clr-namespace:Clubes.Mobile.ViewModels"
            x:Class="Clubes.Mobile.Views.GuestFormPage" x:DataType="vm:GuestFormViewModel" Title="Novo convidado">
    <Grid>
        <ScrollView>
            <VerticalStackLayout Style="{StaticResource PageStack}">
                <Border Style="{StaticResource InfoBanner}">
                    <Label Text="{Binding PolicyText}" />
                </Border>
                <c:FormField Label="Nome completo" Text="{Binding FullName}" MaxLength="150" Error="{Binding NameError}" />
                <c:FormField Label="Documento (opcional)" Text="{Binding Document}" MaxLength="30" />
                <c:FormField Label="Telefone (opcional)" Text="{Binding Phone}" Mask="Phone" MaxLength="30" />
                <Label Text="Data da visita" Style="{StaticResource FieldLabel}" />
                <Border Style="{StaticResource InputBorder}">
                    <DatePicker Date="{Binding VisitDate}" MinimumDate="{Binding MinDate}" Format="dd/MM/yyyy" />
                </Border>
                <Label Text="Espaço (opcional)" Style="{StaticResource FieldLabel}" />
                <Border Style="{StaticResource InputBorder}">
                    <Picker ItemsSource="{Binding Spaces}" SelectedItem="{Binding Space}" Title="Espaço" />
                </Border>
                <Button Text="Cadastrar convidado" Command="{Binding SaveCommand}" />
                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
            </VerticalStackLayout>
        </ScrollView>
        <c:StateView IsLoading="{Binding IsLoading}" ErrorMessage="{Binding ErrorMessage}" RetryCommand="{Binding LoadCommand}" />
    </Grid>
</v:BasePage>
