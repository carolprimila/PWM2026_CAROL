<?xml version="1.0" encoding="utf-8" ?>
<v:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
            xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
            xmlns:c="clr-namespace:Clubes.Mobile.Controls"
            xmlns:m="clr-namespace:Clubes.Mobile.Models"
            xmlns:s="clr-namespace:Clubes.Mobile.Services"
            xmlns:v="clr-namespace:Clubes.Mobile.Views"
            xmlns:vm="clr-namespace:Clubes.Mobile.ViewModels"
            x:Class="Clubes.Mobile.Views.AssemblyDetailPage" x:DataType="vm:AssemblyDetailViewModel" Title="Assembleia">
    <Grid>
        <RefreshView Command="{Binding LoadCommand}" IsRefreshing="{Binding IsRefreshing}">
            <ScrollView>
                <VerticalStackLayout Style="{StaticResource PageStack}">
                    <Border Style="{StaticResource Card}">
                        <VerticalStackLayout Spacing="6">
                            <c:StatusChip Text="{Binding Item.StatusText}" Kind="{Binding Item.StatusKind}" />
                            <Label Text="{Binding Item.Title}" Style="{StaticResource H1}" />
                            <Label Text="{Binding Item.WhenText}" Style="{StaticResource Muted}" />
                        </VerticalStackLayout>
                    </Border>
                    <Label Text="Pauta" Style="{StaticResource Section}" IsVisible="{Binding HasAgenda}" />
                    <Border Style="{StaticResource Card}" IsVisible="{Binding HasAgenda}">
                        <Label Text="{Binding Item.Agenda}" />
                    </Border>
                    <Label Text="Ata" Style="{StaticResource Section}" IsVisible="{Binding HasMinutes}" />
                    <Border Style="{StaticResource Card}" IsVisible="{Binding HasMinutes}">
                        <Label Text="{Binding Item.Minutes}" />
                    </Border>
                    <Button Text="Abrir ata (arquivo)" Style="{StaticResource SecondaryButton}" Command="{Binding OpenMinutesFileCommand}" IsVisible="{Binding HasMinutesFile}" />
                    <Label Text="Documentos" Style="{StaticResource Section}" IsVisible="{Binding HasAttachments}" />
                    <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Attachments}" IsVisible="{Binding HasAttachments}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="m:AttachmentDto">
                                <Border Style="{StaticResource Card}" Padding="12">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnAttachmentTapped" />
                                    </Border.GestureRecognizers>
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                        <Image Source="ic_doc.png" WidthRequest="24" HeightRequest="24" VerticalOptions="Center" />
                                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                                            <Label Text="{Binding DisplayName}" Style="{StaticResource Strong}" />
                                            <Label Text="{Binding SizeText}" Style="{StaticResource Muted}" />
                                        </VerticalStackLayout>
                                        <Label Grid.Column="2" Text="Abrir" TextColor="{StaticResource Primary}" FontFamily="OpenSansSemibold" VerticalOptions="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                    <Label Text="Votações" Style="{StaticResource Section}" IsVisible="{Binding HasPolls}" />
                    <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Polls}" IsVisible="{Binding HasPolls}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="m:PollDto">
                                <Border Style="{StaticResource Card}" Padding="14">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnOpenPoll" />
                                    </Border.GestureRecognizers>
                                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="4">
                                        <Label Text="{Binding Title}" Style="{StaticResource Strong}" />
                                        <c:StatusChip Grid.Column="1" Text="{Binding StatusText}" Kind="{Binding StatusKind}" />
                                        <Label Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding PeriodText}" Style="{StaticResource Muted}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                    <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>
        <c:StateView IsLoading="{Binding IsLoading}" ErrorMessage="{Binding ErrorMessage}" RetryCommand="{Binding LoadCommand}" />
    </Grid>
</v:BasePage>
