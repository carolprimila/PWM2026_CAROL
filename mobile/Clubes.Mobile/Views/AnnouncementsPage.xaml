<?xml version="1.0" encoding="utf-8" ?>
<v:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
            xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
            xmlns:c="clr-namespace:Clubes.Mobile.Controls"
            xmlns:m="clr-namespace:Clubes.Mobile.Models"
            xmlns:s="clr-namespace:Clubes.Mobile.Services"
            xmlns:v="clr-namespace:Clubes.Mobile.Views"
            xmlns:vm="clr-namespace:Clubes.Mobile.ViewModels"
            x:Class="Clubes.Mobile.Views.AnnouncementsPage" x:DataType="vm:AnnouncementsViewModel" Title="Comunicados">
    <Grid RowDefinitions="Auto,*">
        <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
            <HorizontalStackLayout Spacing="8" Padding="16,12" BindableLayout.ItemsSource="{Binding Categories}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:CategoryChip">
                        <c:ChoiceChip Text="{Binding Label}" IsSelected="{Binding IsSelected}">
                            <c:ChoiceChip.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnCategoryTapped" />
                            </c:ChoiceChip.GestureRecognizers>
                        </c:ChoiceChip>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </HorizontalStackLayout>
        </ScrollView>
        <RefreshView Grid.Row="1" Command="{Binding LoadCommand}" IsRefreshing="{Binding IsRefreshing}">
            <CollectionView ItemsSource="{Binding Items}" RemainingItemsThreshold="4" RemainingItemsThresholdReachedCommand="{Binding LoadMoreCommand}">
                <CollectionView.EmptyView>
                    <c:EmptyView Text="Nenhum comunicado por aqui." Icon="ic_megaphone.png" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="m:AnnouncementDto">
                        <Grid Padding="16,6">
                            <Border Style="{StaticResource Card}" Padding="0">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnOpen" />
                                </Border.GestureRecognizers>
                                <VerticalStackLayout>
                                    <c:AuthImage FileId="{Binding ImageFileId}" HeightRequest="150" Aspect="AspectFill" IsVisible="{Binding HasImage}" />
                                    <VerticalStackLayout Spacing="6" Padding="16">
                                        <HorizontalStackLayout Spacing="8">
                                            <BoxView WidthRequest="8" HeightRequest="8" CornerRadius="4" Color="{StaticResource Accent}" VerticalOptions="Center" IsVisible="{Binding IsUnread}" />
                                            <c:StatusChip Text="{Binding CategoryText}" Kind="Info" />
                                            <c:StatusChip Text="{Binding PriorityText}" Kind="{Binding PriorityKind}" />
                                        </HorizontalStackLayout>
                                        <Label Text="{Binding Title}" Style="{StaticResource H2}" />
                                        <Label Text="{Binding Preview}" Style="{StaticResource Muted}" />
                                        <Label Text="{Binding DateText}" Style="{StaticResource Muted}" FontSize="12" />
                                    </VerticalStackLayout>
                                </VerticalStackLayout>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
        <c:StateView Grid.Row="1" IsLoading="{Binding IsLoading}" ErrorMessage="{Binding ErrorMessage}" RetryCommand="{Binding LoadCommand}" />
    </Grid>
</v:BasePage>
