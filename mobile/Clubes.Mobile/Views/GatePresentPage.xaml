<?xml version="1.0" encoding="utf-8" ?>
<v:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
            xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
            xmlns:c="clr-namespace:Clubes.Mobile.Controls"
            xmlns:m="clr-namespace:Clubes.Mobile.Models"
            xmlns:s="clr-namespace:Clubes.Mobile.Services"
            xmlns:v="clr-namespace:Clubes.Mobile.Views"
            xmlns:vm="clr-namespace:Clubes.Mobile.ViewModels"
            x:Class="Clubes.Mobile.Views.GatePresentPage" x:DataType="vm:GatePresentViewModel" Title="Presentes no clube">
    <Grid RowDefinitions="Auto,*">
        <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8" Padding="16,12">
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="8,12">
                <VerticalStackLayout Spacing="2">
                    <Label Text="{Binding Total}" Style="{StaticResource H1}" HorizontalTextAlignment="Center" />
                    <Label Text="Total" Style="{StaticResource Muted}" FontSize="11" HorizontalTextAlignment="Center" MaxLines="1" />
                </VerticalStackLayout>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="8,12">
                <VerticalStackLayout Spacing="2">
                    <Label Text="{Binding Members}" Style="{StaticResource H1}" HorizontalTextAlignment="Center" />
                    <Label Text="Associados" Style="{StaticResource Muted}" FontSize="11" HorizontalTextAlignment="Center" MaxLines="1" />
                </VerticalStackLayout>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="8,12">
                <VerticalStackLayout Spacing="2">
                    <Label Text="{Binding Dependents}" Style="{StaticResource H1}" HorizontalTextAlignment="Center" />
                    <Label Text="Dependentes" Style="{StaticResource Muted}" FontSize="11" HorizontalTextAlignment="Center" MaxLines="1" />
                </VerticalStackLayout>
            </Border>
            <Border Grid.Column="3" Style="{StaticResource Card}" Padding="8,12">
                <VerticalStackLayout Spacing="2">
                    <Label Text="{Binding Guests}" Style="{StaticResource H1}" HorizontalTextAlignment="Center" />
                    <Label Text="Convidados" Style="{StaticResource Muted}" FontSize="11" HorizontalTextAlignment="Center" MaxLines="1" />
                </VerticalStackLayout>
            </Border>
        </Grid>
        <RefreshView Grid.Row="1" Command="{Binding LoadCommand}" IsRefreshing="{Binding IsRefreshing}">
            <CollectionView ItemsSource="{Binding Items}">
                <CollectionView.EmptyView>
                    <c:EmptyView Text="Ninguém no clube neste momento." Icon="ic_group.png" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="m:PresenceDto">
                        <Grid Padding="16,6">
                            <Border Style="{StaticResource Card}" Padding="14">
                                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="2">
                                    <Label Text="{Binding PersonName}" Style="{StaticResource Strong}" />
                                    <c:StatusChip Grid.Column="1" Text="{Binding TypeText}" Kind="Info" />
                                    <Label Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding DetailText}" Style="{StaticResource Muted}" />
                                </Grid>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
        <c:StateView Grid.RowSpan="2" IsLoading="{Binding IsLoading}" ErrorMessage="{Binding ErrorMessage}" RetryCommand="{Binding LoadCommand}" />
    </Grid>
</v:BasePage>
