<?xml version="1.0" encoding="utf-8" ?>
<v:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
            xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
            xmlns:c="clr-namespace:Clubes.Mobile.Controls"
            xmlns:m="clr-namespace:Clubes.Mobile.Models"
            xmlns:s="clr-namespace:Clubes.Mobile.Services"
            xmlns:v="clr-namespace:Clubes.Mobile.Views"
            xmlns:vm="clr-namespace:Clubes.Mobile.ViewModels"
            x:Class="Clubes.Mobile.Views.GuestsPage" x:DataType="vm:GuestsViewModel" Title="Convidados">
    <Grid RowDefinitions="*,Auto">
        <RefreshView Command="{Binding LoadCommand}" IsRefreshing="{Binding IsRefreshing}">
            <CollectionView ItemsSource="{Binding Items}">
                <CollectionView.EmptyView>
                    <c:EmptyView Text="Nenhum convidado cadastrado." Icon="ic_person_add.png" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="m:GuestDto">
                        <Grid Padding="16,6">
                            <Border Style="{StaticResource Card}">
                                <VerticalStackLayout Spacing="6">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <Label Text="{Binding FullName}" Style="{StaticResource H2}" />
                                        <c:StatusChip Grid.Column="1" Text="{Binding StatusText}" Kind="{Binding StatusKind}" />
                                    </Grid>
                                    <Label Text="{Binding VisitText}" />
                                    <Label Text="{Binding FeeText}" Style="{StaticResource Muted}" />
                                    <Label Text="{Binding AuthorizationNote}" Style="{StaticResource Muted}" IsVisible="{Binding HasNote}" />
                                    <Button Text="Cancelar convidado" Style="{StaticResource TextButton}" TextColor="{StaticResource Danger}" HorizontalOptions="Start" Clicked="OnCancel" IsVisible="{Binding CanCancel}" />
                                </VerticalStackLayout>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
        <Grid Grid.Row="1" Padding="16,12" BackgroundColor="{StaticResource Surface}" IsVisible="{Binding CanRegister}">
            <Button Text="Cadastrar convidado" Command="{Binding NewCommand}" />
        </Grid>
        <c:StateView Grid.RowSpan="2" IsLoading="{Binding IsLoading}" ErrorMessage="{Binding ErrorMessage}" RetryCommand="{Binding LoadCommand}" />
    </Grid>
</v:BasePage>
