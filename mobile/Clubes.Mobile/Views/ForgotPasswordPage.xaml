<?xml version="1.0" encoding="utf-8" ?>
<v:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
            xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
            xmlns:c="clr-namespace:Clubes.Mobile.Controls"
            xmlns:m="clr-namespace:Clubes.Mobile.Models"
            xmlns:s="clr-namespace:Clubes.Mobile.Services"
            xmlns:v="clr-namespace:Clubes.Mobile.Views"
            xmlns:vm="clr-namespace:Clubes.Mobile.ViewModels"
            x:Class="Clubes.Mobile.Views.ForgotPasswordPage" x:DataType="vm:ForgotPasswordViewModel" Title="Recuperar senha">
    <ScrollView>
        <VerticalStackLayout Style="{StaticResource PageStack}">
            <Label Text="Esqueceu a senha?" Style="{StaticResource H1}" />
            <Label Text="Informe o e-mail do seu cadastro. Enviaremos um código para você criar uma nova senha." Style="{StaticResource Muted}" />
            <c:FormField Label="E-mail" Text="{Binding Email}" Placeholder="voce@exemplo.com" Keyboard="Email" Error="{Binding EmailError}" />
            <Button Text="Enviar código" Command="{Binding SendCommand}" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
            <Button Text="Já tenho um código" Style="{StaticResource TextButton}" Command="{Binding HaveCodeCommand}" />
        </VerticalStackLayout>
    </ScrollView>
</v:BasePage>
