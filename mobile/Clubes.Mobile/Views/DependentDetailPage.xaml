<?xml version="1.0" encoding="utf-8" ?>
<v:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
            xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
            xmlns:c="clr-namespace:Clubes.Mobile.Controls"
            xmlns:m="clr-namespace:Clubes.Mobile.Models"
            xmlns:s="clr-namespace:Clubes.Mobile.Services"
            xmlns:v="clr-namespace:Clubes.Mobile.Views"
            xmlns:vm="clr-namespace:Clubes.Mobile.ViewModels"
            x:Class="Clubes.Mobile.Views.DependentDetailPage" x:DataType="vm:DependentDetailViewModel" Title="Dependente">
    <Grid>
        <RefreshView Command="{Binding LoadCommand}" IsRefreshing="{Binding IsRefreshing}">
            <ScrollView>
                <VerticalStackLayout Style="{StaticResource PageStack}">
                    <Border Style="{StaticResource Card}">
                        <VerticalStackLayout Spacing="8">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <Border WidthRequest="64" HeightRequest="64" StrokeThickness="0" StrokeShape="RoundRectangle 32" BackgroundColor="{StaticResource NeutralSoft}">
                                    <c:AuthImage FileId="{Binding Item.PhotoFileId}" Placeholder="ic_person_light.png" Aspect="AspectFill" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                    <Label Text="{Binding Item.FullName}" Style="{StaticResource H2}" />
                                    <c:StatusChip Text="{Binding Item.StatusText}" Kind="{Binding Item.StatusKind}" />
                                </VerticalStackLayout>
                            </Grid>
                            <Label Text="{Binding InfoText}" />
                            <Label Text="{Binding Item.StatusReason, StringFormat='Motivo: {0}'}" TextColor="{StaticResource Danger}" IsVisible="{Binding HasStatusReason}" />
                        </VerticalStackLayout>
                    </Border>

                    <Label Text="Permissões" Style="{StaticResource Section}" />
                    <Label Text="Uma permissão só vale quando a administração do clube libera e você habilita." Style="{StaticResource Muted}" />
                    <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Permissions}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:PermissionItem">
                                <Border Style="{StaticResource Card}" Padding="14">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                        <VerticalStackLayout Spacing="4">
                                            <Label Text="{Binding Title}" Style="{StaticResource Strong}" />
                                            <Label Text="{Binding Hint}" Style="{StaticResource Muted}" />
                                            <c:StatusChip Text="{Binding EffectiveText}" Kind="{Binding EffectiveKind}" />
                                        </VerticalStackLayout>
                                        <Switch Grid.Column="1" IsToggled="{Binding EnabledByMember, Mode=OneTime}" IsEnabled="{Binding CanToggle}" Toggled="OnPermissionToggled" VerticalOptions="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <Label Text="Acesso ao aplicativo" Style="{StaticResource Section}" />
                    <Border Style="{StaticResource Card}">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="{Binding AccessText}" />
                            <Button Text="Criar acesso ao aplicativo" Style="{StaticResource SecondaryButton}" Command="{Binding CreateAccessCommand}" IsVisible="{Binding CanCreateAccess}" />
                        </VerticalStackLayout>
                    </Border>

                    <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
                    <Button Text="Editar dados" Style="{StaticResource SecondaryButton}" Command="{Binding EditCommand}" IsVisible="{Binding CanManage}" />
                    <Button Text="Remover dependente" Style="{StaticResource DangerButton}" Command="{Binding RemoveCommand}" IsVisible="{Binding CanManage}" />
                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>
        <c:StateView IsLoading="{Binding IsLoading}" ErrorMessage="{Binding ErrorMessage}" RetryCommand="{Binding LoadCommand}" />
    </Grid>
</v:BasePage>
