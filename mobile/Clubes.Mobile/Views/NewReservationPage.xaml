<?xml version="1.0" encoding="utf-8" ?>
<v:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
            xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
            xmlns:c="clr-namespace:Clubes.Mobile.Controls"
            xmlns:m="clr-namespace:Clubes.Mobile.Models"
            xmlns:s="clr-namespace:Clubes.Mobile.Services"
            xmlns:v="clr-namespace:Clubes.Mobile.Views"
            xmlns:vm="clr-namespace:Clubes.Mobile.ViewModels"
            x:Class="Clubes.Mobile.Views.NewReservationPage" x:DataType="vm:NewReservationViewModel" Title="Nova reserva">
    <Grid RowDefinitions="*,Auto">
        <ScrollView>
            <VerticalStackLayout Style="{StaticResource PageStack}">
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="{Binding Space.Name}" Style="{StaticResource H1}" />
                        <Label Text="{Binding Space.Subtitle}" Style="{StaticResource Muted}" />
                        <Label Text="{Binding Space.PriceText}" TextColor="{StaticResource Primary}" FontSize="13" />
                        <Label Text="{Binding Space.UsageRules}" Style="{StaticResource Muted}" IsVisible="{Binding HasUsageRules}" Margin="0,8,0,0" />
                    </VerticalStackLayout>
                </Border>

                <VerticalStackLayout Spacing="8" IsVisible="{Binding IsHourly}">
                    <Label Text="Data" Style="{StaticResource FieldLabel}" />
                    <Border Style="{StaticResource InputBorder}">
                        <DatePicker Date="{Binding Date}" MinimumDate="{Binding MinDate}" Format="dd/MM/yyyy" />
                    </Border>
                    <Label Text="Horários (toque para selecionar um ou mais)" Style="{StaticResource FieldLabel}" />
                    <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding SlotRows}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:SlotRow">
                                <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8" BindableLayout.ItemsSource="{Binding .}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="vm:SlotItem">
                                            <c:ChoiceChip Grid.Column="{Binding Column}" Text="{Binding Label}" Caption="{Binding Caption}" IsSelected="{Binding IsSelected}" Tone="{Binding Tone}">
                                                <c:ChoiceChip.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="OnSlotTapped" />
                                                </c:ChoiceChip.GestureRecognizers>
                                            </c:ChoiceChip>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="8" IsVisible="{Binding IsMultiDay}">
                    <Border Style="{StaticResource InfoBanner}">
                        <Label Text="{Binding PeriodExplanation}" />
                    </Border>
                    <Label Text="Data de início" Style="{StaticResource FieldLabel}" />
                    <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding DayRows}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:DayRow">
                                <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8" BindableLayout.ItemsSource="{Binding .}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="vm:DayItem">
                                            <c:ChoiceChip Grid.Column="{Binding Column}" Text="{Binding Label}" Caption="{Binding Caption}" IsSelected="{Binding IsSelected}" Tone="{Binding Tone}">
                                                <c:ChoiceChip.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="OnDayTapped" />
                                                </c:ChoiceChip.GestureRecognizers>
                                            </c:ChoiceChip>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                    <Button Text="Ver mais datas" Style="{StaticResource TextButton}" Command="{Binding MoreDaysCommand}" />
                </VerticalStackLayout>

                <ActivityIndicator IsRunning="{Binding IsLoadingAvailability}" IsVisible="{Binding IsLoadingAvailability}" />
                <Border Style="{StaticResource WarningBanner}" IsVisible="{Binding HasDayMessage}">
                    <Label Text="{Binding DayMessage}" TextColor="{StaticResource Warning}" />
                </Border>

                <Label Text="Detalhes" Style="{StaticResource Section}" />
                <c:FormField Label="Quantidade de pessoas" Text="{Binding PeopleCount}" Mask="Digits" MaxLength="5" Error="{Binding PeopleError}" />
                <c:FormField Label="Observações (opcional)" Text="{Binding Notes}" Multiline="True" MaxLength="1000" />

                <Label Text="Convidados (opcional)" Style="{StaticResource Section}" />
                <Label Text="{Binding GuestsHint}" Style="{StaticResource Muted}" />
                <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Guests}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="m:GuestInput">
                            <Border Style="{StaticResource Card}" Padding="12">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                        <Label Text="{Binding FullName}" Style="{StaticResource Strong}" />
                                        <Label Text="{Binding DetailText}" Style="{StaticResource Muted}" />
                                    </VerticalStackLayout>
                                    <Button Grid.Column="1" Text="Remover" Style="{StaticResource TextButton}" TextColor="{StaticResource Danger}" Clicked="OnRemoveGuest" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="8" IsVisible="{Binding CanAddGuest}">
                    <c:FormField Label="Nome do convidado" Text="{Binding GuestName}" MaxLength="150" Error="{Binding GuestError}" />
                    <c:FormField Label="Documento" Text="{Binding GuestDocument}" MaxLength="30" />
                    <c:FormField Label="Telefone" Text="{Binding GuestPhone}" Mask="Phone" MaxLength="30" />
                    <Button Text="Adicionar convidado" Style="{StaticResource SecondaryButton}" Command="{Binding AddGuestCommand}" />
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <VerticalStackLayout Grid.Row="1" Padding="16,12" Spacing="8" BackgroundColor="{StaticResource Surface}">
            <Label Text="{Binding SelectionText}" Style="{StaticResource Muted}" />
            <Border Style="{StaticResource InfoBanner}" IsVisible="{Binding HasQuote}">
                <VerticalStackLayout Spacing="6">
                    <Label Text="{Binding QuotePeriodText}" Style="{StaticResource Strong}" />
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="4">
                        <Label Text="Locação" />
                        <Label Grid.Column="1" Text="{Binding QuoteRentalText}" />
                        <Label Grid.Row="1" Text="Taxa de limpeza" />
                        <Label Grid.Row="1" Grid.Column="1" Text="{Binding QuoteCleaningText}" />
                        <Label Grid.Row="2" Text="Total" Style="{StaticResource Strong}" VerticalOptions="Center" />
                        <Label Grid.Row="2" Grid.Column="1" Text="{Binding QuoteTotalText}" Style="{StaticResource Amount}" />
                    </Grid>
                    <Label Text="{Binding QuoteChargeText}" Style="{StaticResource Muted}" />
                    <Label Text="{Binding QuoteApprovalText}" Style="{StaticResource Muted}" />
                    <VerticalStackLayout Spacing="2" BindableLayout.ItemsSource="{Binding QuoteNotes}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Label Text="{Binding ., StringFormat='• {0}'}" Style="{StaticResource Muted}" />
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>
            <Button Text="Ver valores" Command="{Binding SimulateCommand}" IsVisible="{Binding NoQuote}" />
            <Button Text="Confirmar reserva" Command="{Binding ConfirmCommand}" IsVisible="{Binding HasQuote}" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
        </VerticalStackLayout>
        <c:StateView Grid.RowSpan="2" IsLoading="{Binding IsLoading}" ErrorMessage="{Binding ErrorMessage}" RetryCommand="{Binding LoadCommand}" />
    </Grid>
</v:BasePage>
