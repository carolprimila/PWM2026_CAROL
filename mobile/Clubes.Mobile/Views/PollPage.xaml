<?xml version="1.0" encoding="utf-8" ?>
<v:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
            xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
            xmlns:c="clr-namespace:Clubes.Mobile.Controls"
            xmlns:m="clr-namespace:Clubes.Mobile.Models"
            xmlns:s="clr-namespace:Clubes.Mobile.Services"
            xmlns:v="clr-namespace:Clubes.Mobile.Views"
            xmlns:vm="clr-namespace:Clubes.Mobile.ViewModels"
            x:Class="Clubes.Mobile.Views.PollPage" x:DataType="vm:PollViewModel" Title="Votação">
    <Grid RowDefinitions="*,Auto">
        <RefreshView Command="{Binding LoadCommand}" IsRefreshing="{Binding IsRefreshing}">
            <ScrollView>
                <VerticalStackLayout Style="{StaticResource PageStack}">
                    <c:StatusChip Text="{Binding Poll.StatusText}" Kind="{Binding Poll.StatusKind}" />
                    <Label Text="{Binding Poll.Title}" Style="{StaticResource H1}" />
                    <Label Text="{Binding Poll.AssemblyTitle}" Style="{StaticResource Muted}" />
                    <Label Text="{Binding Poll.PeriodText}" Style="{StaticResource Muted}" />
                    <Label Text="{Binding Poll.Description}" FontSize="15" IsVisible="{Binding HasDescription}" />
                    <Border Style="{StaticResource InfoBanner}">
                        <Label Text="{Binding InfoText}" />
                    </Border>
                    <Label Text="{Binding ResultsText}" Style="{StaticResource Strong}" />
                    <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Options}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:PollOptionItem">
                                <VerticalStackLayout Spacing="4">
                                    <c:ChoiceChip Text="{Binding Text}" Caption="{Binding VotesText}" IsSelected="{Binding IsSelected}">
                                        <c:ChoiceChip.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnOptionTapped" />
                                        </c:ChoiceChip.GestureRecognizers>
                                    </c:ChoiceChip>
                                    <ProgressBar Progress="{Binding Share}" IsVisible="{Binding ShowVotes}" />
                                </VerticalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>
        <VerticalStackLayout Grid.Row="1" Padding="16,12" Spacing="8" BackgroundColor="{StaticResource Surface}" IsVisible="{Binding CanVote}">
            <Button Text="Votar" Command="{Binding VoteCommand}" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
        </VerticalStackLayout>
        <c:StateView Grid.RowSpan="2" IsLoading="{Binding IsLoading}" ErrorMessage="{Binding ErrorMessage}" RetryCommand="{Binding LoadCommand}" />
    </Grid>
</v:BasePage>
