<?xml version="1.0" encoding="utf-8" ?>
<v:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
            xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
            xmlns:c="clr-namespace:Clubes.Mobile.Controls"
            xmlns:m="clr-namespace:Clubes.Mobile.Models"
            xmlns:s="clr-namespace:Clubes.Mobile.Services"
            xmlns:v="clr-namespace:Clubes.Mobile.Views"
            xmlns:vm="clr-namespace:Clubes.Mobile.ViewModels"
            x:Class="Clubes.Mobile.Views.EventsPage" x:DataType="vm:EventsViewModel" Title="Eventos">
    <Grid>
        <RefreshView Command="{Binding LoadCommand}" IsRefreshing="{Binding IsRefreshing}">
            <CollectionView ItemsSource="{Binding Items}">
                <CollectionView.EmptyView>
                    <c:EmptyView Text="Nenhum evento programado." Icon="ic_star.png" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="m:EventDto">
                        <Grid Padding="16,6">
                            <Border Style="{StaticResource Card}" Padding="0">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnOpen" />
                                </Border.GestureRecognizers>
                                <VerticalStackLayout>
                                    <c:AuthImage FileId="{Binding ImageFileId}" HeightRequest="140" Aspect="AspectFill" IsVisible="{Binding HasImage}" />
                                    <VerticalStackLayout Spacing="6" Padding="16">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <Label Text="{Binding Title}" Style="{StaticResource H2}" />
                                            <c:StatusChip Grid.Column="1" Text="{Binding StatusText}" Kind="{Binding StatusKind}" />
                                        </Grid>
                                        <Label Text="{Binding WhenText}" />
                                        <Label Text="{Binding Location}" Style="{StaticResource Muted}" IsVisible="{Binding HasLocation}" />
                                    </VerticalStackLayout>
                                </VerticalStackLayout>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
        <c:StateView IsLoading="{Binding IsLoading}" ErrorMessage="{Binding ErrorMessage}" RetryCommand="{Binding LoadCommand}" />
    </Grid>
</v:BasePage>
