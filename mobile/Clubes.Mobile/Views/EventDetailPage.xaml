<?xml version="1.0" encoding="utf-8" ?>
<v:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
            xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
            xmlns:c="clr-namespace:Clubes.Mobile.Controls"
            xmlns:m="clr-namespace:Clubes.Mobile.Models"
            xmlns:s="clr-namespace:Clubes.Mobile.Services"
            xmlns:v="clr-namespace:Clubes.Mobile.Views"
            xmlns:vm="clr-namespace:Clubes.Mobile.ViewModels"
            x:Class="Clubes.Mobile.Views.EventDetailPage" x:DataType="vm:EventDetailViewModel" Title="Evento">
    <Grid>
        <RefreshView Command="{Binding LoadCommand}" IsRefreshing="{Binding IsRefreshing}">
            <ScrollView>
                <VerticalStackLayout Spacing="0">
                    <c:AuthImage FileId="{Binding Item.ImageFileId}" HeightRequest="200" Aspect="AspectFill" IsVisible="{Binding Item.HasImage}" />
                    <VerticalStackLayout Style="{StaticResource PageStack}">
                        <c:StatusChip Text="{Binding Item.StatusText}" Kind="{Binding Item.StatusKind}" />
                        <Label Text="{Binding Item.Title}" Style="{StaticResource H1}" />
                        <Border Style="{StaticResource Card}">
                            <VerticalStackLayout Spacing="6">
                                <Label Text="{Binding Item.WhenText}" Style="{StaticResource Strong}" />
                                <Label Text="{Binding Item.Location}" IsVisible="{Binding Item.HasLocation}" />
                                <Label Text="{Binding Item.SeatsText}" Style="{StaticResource Muted}" />
                            </VerticalStackLayout>
                        </Border>
                        <Border Style="{StaticResource DangerBanner}" IsVisible="{Binding HasCancelReason}">
                            <Label Text="{Binding Item.CancelReason, StringFormat='Evento cancelado: {0}'}" TextColor="{StaticResource Danger}" />
                        </Border>
                        <Label Text="{Binding Item.Description}" FontSize="15" IsVisible="{Binding HasDescription}" />
                        <Border Style="{StaticResource InfoBanner}">
                            <Label Text="{Binding RegistrationInfo}" />
                        </Border>
                        <Button Text="Inscrever-me" Command="{Binding RegisterCommand}" IsVisible="{Binding ShowRegister}" />
                        <Button Text="Cancelar inscrição" Style="{StaticResource DangerButton}" Command="{Binding CancelRegistrationCommand}" IsVisible="{Binding ShowCancel}" />
                        <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>
        <c:StateView IsLoading="{Binding IsLoading}" ErrorMessage="{Binding ErrorMessage}" RetryCommand="{Binding LoadCommand}" />
    </Grid>
</v:BasePage>
