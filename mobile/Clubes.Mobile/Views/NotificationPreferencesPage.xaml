<?xml version="1.0" encoding="utf-8" ?>
<v:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
            xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
            xmlns:c="clr-namespace:Clubes.Mobile.Controls"
            xmlns:m="clr-namespace:Clubes.Mobile.Models"
            xmlns:s="clr-namespace:Clubes.Mobile.Services"
            xmlns:v="clr-namespace:Clubes.Mobile.Views"
            xmlns:vm="clr-namespace:Clubes.Mobile.ViewModels"
            x:Class="Clubes.Mobile.Views.NotificationPreferencesPage" x:DataType="vm:NotificationPreferencesViewModel" Title="Preferências de notificação">
    <Grid RowDefinitions="*,Auto">
        <ScrollView>
            <VerticalStackLayout Style="{StaticResource PageStack}">
                <Border Style="{StaticResource InfoBanner}">
                    <Label Text="Escolha como deseja ser avisado em cada assunto. Notificações obrigatórias do clube (como avisos importantes e cobranças) são sempre entregues." />
                </Border>
                <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Items}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="m:NotificationPreferenceDto">
                            <Border Style="{StaticResource Card}" Padding="14">
                                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="2">
                                    <Label Grid.ColumnSpan="2" Text="{Binding CategoryText}" Style="{StaticResource H2}" />
                                    <Label Grid.Row="1" Text="No aplicativo" VerticalOptions="Center" />
                                    <Switch Grid.Row="1" Grid.Column="1" IsToggled="{Binding InAppEnabled, Mode=TwoWay}" />
                                    <Label Grid.Row="2" Text="Push" VerticalOptions="Center" />
                                    <Switch Grid.Row="2" Grid.Column="1" IsToggled="{Binding PushEnabled, Mode=TwoWay}" />
                                    <Label Grid.Row="3" Text="E-mail" VerticalOptions="Center" />
                                    <Switch Grid.Row="3" Grid.Column="1" IsToggled="{Binding EmailEnabled, Mode=TwoWay}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
        <VerticalStackLayout Grid.Row="1" Padding="16,12" Spacing="8" BackgroundColor="{StaticResource Surface}">
            <Button Text="Salvar preferências" Command="{Binding SaveCommand}" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
        </VerticalStackLayout>
        <c:StateView Grid.RowSpan="2" IsLoading="{Binding IsLoading}" ErrorMessage="{Binding ErrorMessage}" RetryCommand="{Binding LoadCommand}" />
    </Grid>
</v:BasePage>
