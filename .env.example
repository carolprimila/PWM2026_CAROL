# Copie para .env e preencha. O arquivo .env não vai para o repositório.

# --- API ---
# Production em servidores; Development só na máquina do desenvolvedor.
ASPNETCORE_ENVIRONMENT=Production
API_PORT=5080
# Chave HMAC do JWT, mínimo 32 caracteres (ex.: openssl rand -base64 48)
JWT_CHAVE=
# Cria/atualiza o banco SQLite ao iniciar (recomendado).
APLICAR_MIGRATIONS=true
# Opcional: token fixo para criar o primeiro Superadmin. Vazio = token aleatório exibido no log da API.
SETUP_TOKEN=
# Dados de demonstração (clubes Foz 2 e Guaíra 2). A API se recusa a iniciar em Production com isto ligado.
SEED_DEMO=false
SEED_SENHA_DEMO=
# Swagger em produção só se for necessário (e atrás de autenticação no proxy).
SWAGGER_HABILITADO=false

# --- E-mail (recuperação de senha e convites) ---
# Arquivo = grava .eml em App_Data/emails (desenvolvimento). Smtp = envio real.
EMAIL_PROVEDOR=Arquivo
EMAIL_REMETENTE=nao-responda@seudominio.com.br
SMTP_HOST=
SMTP_PORTA=587
SMTP_USUARIO=
SMTP_SENHA=

# --- Web administrativo ---
WEB_PORT=5278
# Endereço público do Web (usado nos links de e-mail). Em produção: https://admin.seudominio.com.br
WEB_URL=http://localhost:5278
