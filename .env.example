# Copie para .env e preencha. Nunca versione o arquivo .env.

# --- PostgreSQL ---
POSTGRES_DB=clubes
POSTGRES_USER=clubes
POSTGRES_PASSWORD=troque-esta-senha

# --- API ---
ASPNETCORE_ENVIRONMENT=Production
# Chave de assinatura dos tokens (mínimo 32 caracteres aleatórios)
JWT_KEY=
# Origens autorizadas a chamar a API (aplicação Web)
CORS_ORIGIN=http://localhost:8081
# URL pública da tela de redefinição de senha (enviada por e-mail)
PASSWORD_RESET_URL=http://localhost:8081/redefinir-senha
SWAGGER_ENABLED=false

# --- Inicialização (usado somente em banco vazio) ---
SUPERADMIN_NAME=Superadministrador
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
# Primeira sede. A segunda sede (ex.: Daros Foz) é criada pelo superadministrador em Plataforma > Clubes.
CLUB_NAME=Daros Guaíra
CLUB_ADMIN_NAME=Administrador Daros Guaíra
CLUB_ADMIN_EMAIL=
CLUB_ADMIN_PASSWORD=

# --- E-mail (opcional: recuperação de senha e avisos obrigatórios) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Pagamentos: None (padrão) ou Sandbox (somente homologação) ---
PAYMENTS_PROVIDER=None
PAYMENTS_SANDBOX_SECRET=

# --- Push (opcional): caminho, dentro do contêiner, do JSON da conta de serviço do Firebase ---
FIREBASE_CREDENTIALS_FILE=

# --- Backup ---
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=14

# --- Portas publicadas ---
API_PORT=8080
WEB_PORT=8081
# URL da API vista pelo navegador (usada na compilação do Web)
VITE_API_URL=http://localhost:8080
