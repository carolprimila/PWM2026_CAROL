{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": ""
  },
  "Jwt": {
    "Issuer": "clubes-api",
    "Audience": "clubes-clients",
    "Key": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },
  "Auth": {
    "MaxFailedAttempts": 5,
    "LockoutMinutes": 15,
    "PasswordResetMinutes": 30,
    "PasswordResetUrl": ""
  },
  "Cors": {
    "Origins": []
  },
  "RateLimit": {
    "PerMinute": 600,
    "AuthPerMinute": 10
  },
  "Storage": {
    "RootPath": "storage"
  },
  "Email": {
    "Smtp": {
      "Host": "",
      "Port": 587,
      "User": "",
      "Password": "",
      "From": "",
      "FromName": "Clube",
      "UseSsl": true
    }
  },
  "Push": {
    "FirebaseCredentialsFile": ""
  },
  "Payments": {
    "Provider": "None",
    "SandboxSecret": ""
  },
  "Routines": {
    "Enabled": true,
    "IntervalMinutes": 15,
    "DispatchIntervalSeconds": 10
  },
  "Bootstrap": {
    "AutoMigrate": true
  },
  "Swagger": {
    "Enabled": false
  }
}
